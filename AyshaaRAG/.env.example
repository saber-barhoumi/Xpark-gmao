# ── Ayshaa RAG — configuration (copier vers .env, ne JAMAIS committer .env) ──

# Service
AYSHAA_PORT=8010
AYSHAA_LOG_LEVEL=INFO

# CORS — origines autorisées (frontoffice)
AYSHAA_CORS_ORIGINS=["http://localhost:3001","http://localhost:8080"]

# Qdrant (base vectorielle)
AYSHAA_QDRANT_URL=http://qdrant:6333
AYSHAA_QDRANT_COLLECTION=ayshaa_kb

# Embeddings (fastembed / ONNX — multilingue fr/en/ar, 384 dimensions)
AYSHAA_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM génératif (optionnel — dégradation gracieuse en mode extractif si absent)
AYSHAA_LLM_ENABLED=true
AYSHAA_OLLAMA_URL=http://ollama:11434
AYSHAA_OLLAMA_MODEL=qwen2.5:3b-instruct
AYSHAA_OLLAMA_TIMEOUT=60

# Mémoire de conversation
AYSHAA_MEMORY_DB=/data/ayshaa_memory.db
AYSHAA_MEMORY_MAX_TURNS=8
AYSHAA_MEMORY_TTL_HOURS=24

# Sécurité
AYSHAA_ADMIN_API_KEY=change-me-in-production
AYSHAA_RATE_LIMIT_RPM=30

# Chemins
AYSHAA_KNOWLEDGE_DIR=knowledge
AYSHAA_DATA_DIR=/data
