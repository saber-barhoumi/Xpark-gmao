<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Couche presentation alertes - cablage via AddAlertsInfrastructure. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Alerts.API</RootNamespace>
    <AssemblyName>Alerts.API</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Alerts.Application\Alerts.Application.csproj" />
    <ProjectReference Include="..\Alerts.Infrastructure\Alerts.Infrastructure.csproj" />
  </ItemGroup>
</Project>
