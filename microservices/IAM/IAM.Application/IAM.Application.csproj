<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cas d'usage — dépend UNIQUEMENT du Domain.
       Contient les DTOs (contrats), les interfaces de services (implémentées
       par l'Infrastructure) et le mapping AutoMapper. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IAM.Application</RootNamespace>
