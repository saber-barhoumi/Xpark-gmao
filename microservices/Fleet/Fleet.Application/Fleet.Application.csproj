<Project Sdk="Microsoft.NET.Sdk">
  <!-- Cas d'usage flotte — DTOs, interfaces (services + bus d'événements),
       mapping AutoMapper. Dépend uniquement du Domain. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fleet.Application</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fleet.Domain\Fleet.Domain.csproj" />
  </ItemGroup>
</Project>
