<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Couche présentation missions — le câblage passe par AddMissionInfrastructure. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mission.API</RootNamespace>
    <AssemblyName>Mission.API</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mission.Application\Mission.Application.csproj" />
    <ProjectReference Include="..\Mission.Infrastructure\Mission.Infrastructure.csproj" />
  </ItemGroup>
</Project>
