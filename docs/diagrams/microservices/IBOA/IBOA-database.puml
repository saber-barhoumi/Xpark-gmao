@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IBOA - Persistance

database "postgres : xpark_gmao" #FFF8E1 {
  entity "evenements notes" as EV
  entity "alertes" as AL
  entity "preferences" as PR
}
component "storage.py\npsycopg2" as ST #FCE4EC
ST --> EV
ST --> AL
ST --> PR

legend right
IBOA ecrit directement en SQL via psycopg2 (module storage.py),
sans ORM ni migrations.
endlegend

@enduml
