@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

skinparam ActivityBackgroundColor #F5F7FA
skinparam ActivityBorderColor #78909C

start
:Consommation depuis la file iboa.events;
:Deserialisation JSON (sans enveloppe);
:Enrichissement du contexte;
:Score de base selon le type d'evenement\n(table BASE_SCORES);
:Application des modificateurs\n(contexte, impact, frequence, severite);
if (Criticite calculee) then (>= 85)
  :CRITIQUE;
elseif (60 a 84) then
  :IMPORTANT;
elseif (30 a 59) then
  :NORMAL;
else (< 30)
  :INFO;
endif
:Agregation avec les evenements lies;
:Enregistrement dans PostgreSQL;
if (Diffusion justifiee ?) then (oui)
  :Mise en forme en langage metier;
  :Envoi (courriel, rapport PDF ou XLSX);
endif
:Disponible dans /monitoring/iboa;
stop

@enduml
