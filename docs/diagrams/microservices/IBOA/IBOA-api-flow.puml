@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IBOA - Cheminement d'un appel API

autonumber

actor Client as U
participant "backoffice" as BO #E1F5FE
participant "nginx back-office" as N1
participant "nginx passerelle" as N2
participant "iboa\nFastAPI" as A #FCE4EC

U -> BO : action
BO -> A : GET /events
activate A
A -> A : lecture du journal (storage.py)
A --> BO : evenements notes
deactivate A

legend right
14 endpoints FastAPI exposes par ce service.
endlegend

@enduml
