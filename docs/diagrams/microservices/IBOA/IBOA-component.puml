@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IBOA - Diagramme de composants

skinparam componentStyle rectangle

component "backoffice (React)" as BO #E1F5FE
component "nginx (passerelle)" as GWc #ECEFF1

package "conteneur iboa (:5008)" #E8F5E9 {
  package "API FastAPI" {
    component "14 endpoints" as EPS
  }
  package "Modules" {
    component "aggregator.py" as aggregator_py
    component "delivery.py" as delivery_py
    component "formatters.py" as formatters_py
    component "main.py" as main_py
    component "models.py" as models_py
    component "pipeline.py" as pipeline_py
    component "rabbitmq_consumer.py" as rabbitmq_consumer_py
    component "scorer.py" as scorer_py
    component "storage.py" as storage_py
  }
}

database "postgres\nxpark_gmao" as PG #FFF8E1
queue "rabbitmq" as MQ #ECEFF1

EPS --> PG
MQ --> EPS
EPS --> MQ

@enduml
