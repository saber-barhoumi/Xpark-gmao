@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IBOA - Cas d'utilisation

left to right direction

:ADMIN: as ADMIN

rectangle "IBOA" {
  package "API FastAPI" {
    usecase "health\nGET /health" as healthGET
    usecase "get_events\nGET /events" as get_eventsGET
    usecase "delete_events\nPOST /events/delete" as delete_eventsPOST
    usecase "delete_all_events\nDELETE /events" as delete_all_eventsDELETE
    usecase "get_alerts\nGET /alerts" as get_alertsGET
    usecase "delete_alerts\nPOST /alerts/delete" as delete_alertsPOST
    usecase "delete_all_alerts\nDELETE /alerts" as delete_all_alertsDELETE
    usecase "get_stats\nGET /stats" as get_statsGET
    usecase "get_preferences\nGET /preferences" as get_preferencesGET
    usecase "put_preferences\nPUT /preferences" as put_preferencesPUT
    usecase "daily_pdf\nGET /reports/daily.pdf" as daily_pdfGET
    usecase "daily_excel\nGET /reports/daily.xlsx" as daily_excelGET
    usecase "force_flush_batch\nPOST /batch/flush" as force_flush_batchPOST
    usecase "post_test_event\nPOST /test-event" as post_test_eventPOST
  }
}

ADMIN --> healthGET
ADMIN --> get_eventsGET
ADMIN --> delete_eventsPOST
ADMIN --> delete_all_eventsDELETE
ADMIN --> get_alertsGET
ADMIN --> delete_alertsPOST
ADMIN --> delete_all_alertsDELETE
ADMIN --> get_statsGET
ADMIN --> get_preferencesGET
ADMIN --> put_preferencesPUT
ADMIN --> daily_pdfGET
ADMIN --> daily_excelGET
ADMIN --> force_flush_batchPOST
ADMIN --> post_test_eventPOST

legend right
Service interne : il n'expose pas de RBAC propre, l'acces est
filtre en amont (passerelle ou service appelant).
endlegend

@enduml
