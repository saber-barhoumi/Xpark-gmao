@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members
skinparam componentStyle rectangle
left to right direction


title IBOA - Diagramme de communication

' 1. Clients
component "backoffice\n<<interface utilisateur>>" as BO #E1F5FE

' 2. Service
component "iboa\n<<service IA>>" as API #FCE4EC

' 3. Messagerie et persistance
queue "rabbitmq\n<<bus de messages>>" as MQ #FFF3E0
database "postgres\n<<base de donnees>>" as BD #FFF8E1
component "services metier\n<<microservices>>" as MET #E8F5E9
component "diffusion\n<<systemes tiers>>" as DIF #ECEFF1

MET --> MQ : evenements metier
MQ --> API : liaison xpark.#
API --> BD : psycopg2
API --> DIF : courriel / message instantane
BO --> API : consultation du journal

@enduml
