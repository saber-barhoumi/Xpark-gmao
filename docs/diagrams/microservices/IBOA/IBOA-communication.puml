@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IBOA - Communications

skinparam componentStyle rectangle

component "**iboa**" as ME #E8F5E9

component "backoffice" as BO #E1F5FE
component "nginx" as GWc #ECEFF1
database "postgres" as PG #FFF8E1
queue "rabbitmq" as MQ #ECEFF1

component "fleet-api" as FL #E8F5E9
component "mission-api" as MS #E8F5E9
FL -[#CC6600]-> MQ : vehicle-added / vehicle-breakdown\n/ maintenance-due
MS -[#CC6600]-> MQ : client-request / task-completed\n/ task-cancelled
MQ -[#CC6600]-> ME : file iboa.events (liaison xpark.#)
ME -[#666666]-> PG : psycopg2
BO -[#0066CC]-> ME : consultation du journal
component "SMTP" as SM #ECEFF1
component "API Twilio\n(WhatsApp)" as TW #ECEFF1
ME -[#0066CC]-> SM : send_email (smtplib)
ME -[#0066CC]-> TW : send_whatsapp (HTTPS)
note bottom of TW
  Canal optionnel : actif seulement si
  TWILIO_SID est configure
  (whatsapp_configured()).
end note

legend right
Bleu : HTTP · Orange : AMQP · Vert : WebSocket · Gris : base de donnees.
endlegend

@enduml
