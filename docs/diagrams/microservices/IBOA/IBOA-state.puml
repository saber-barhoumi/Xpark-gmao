@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

skinparam state {
  BackgroundColor #F5F7FA
  BorderColor #78909C
}

[*] --> Recu : message consomme
Recu --> Note : criticite calculee
Note --> INFO : score < 30
Note --> NORMAL : 30 a 59
Note --> IMPORTANT : 60 a 84
Note --> CRITIQUE : score >= 85
INFO --> Journalise
NORMAL --> Journalise
IMPORTANT --> Diffuse : mise en forme + envoi
CRITIQUE --> Diffuse
Diffuse --> Journalise
Journalise --> [*] : consultable dans /monitoring/iboa

@enduml
