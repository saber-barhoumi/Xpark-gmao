@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

skinparam componentStyle rectangle

package "Presentation" {
  component "Point d'entree du service" as ENTREE
}
package "Traitement" {
  component "aggregator.py" as aggregator_py
  component "delivery.py" as delivery_py
  component "formatters.py" as formatters_py
  component "main.py" as main_py
  component "models.py" as models_py
  component "pipeline.py" as pipeline_py
  component "rabbitmq_consumer.py" as rabbitmq_consumer_py
  component "scorer.py" as scorer_py
}

ENTREE --> aggregator_py
aggregator_py --> delivery_py
delivery_py --> formatters_py
formatters_py --> main_py
main_py --> models_py
models_py --> pipeline_py
pipeline_py --> rabbitmq_consumer_py
rabbitmq_consumer_py --> scorer_py

@enduml
