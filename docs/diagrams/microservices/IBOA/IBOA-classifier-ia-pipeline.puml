@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IBOA - Chaine de notation des evenements

skinparam ActivityBackgroundColor #FCE4EC

start
:Evenement recu\n(routing key sous le prefixe xpark);
:Recherche du score de base\n(table BASE_SCORES, ~40 types);
partition "Modificateurs" {
  :Contexte;
  :Impact;
  :Frequence;
  :Severite;
}
:Criticite = base + modificateurs;
if (Criticite) then (>= 85)
  :CRITIQUE;
elseif (60 a 84) then
  :IMPORTANT;
elseif (30 a 59) then
  :NORMAL;
else (< 30)
  :INFO;
endif
:Agregation;
:Journalisation;
stop

legend right
Notation DETERMINISTE : une table de scores et des modificateurs,
aucun modele entraine. Les seuils sont ceux ecrits dans scorer.py.
endlegend

@enduml
