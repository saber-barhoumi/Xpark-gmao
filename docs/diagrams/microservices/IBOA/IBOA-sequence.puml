@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IBOA - Notation et journalisation d'un evenement metier

autonumber

participant "fleet-api / mission-api" as SRC
queue "rabbitmq\nexchange xpark.ai" as MQ
participant "rabbitmq_consumer.py" as RC
participant "pipeline.py" as PL
participant "scorer.py" as SC
participant "aggregator.py" as AG
participant "formatters.py" as FM
participant "delivery.py" as DL
participant "storage.py" as ST
database "postgres" as PG
actor "ADMIN" as A
participant "backoffice" as BO

SRC -> MQ : publication\n(ex. xpark.fleet.vehicle-breakdown)
MQ -> RC : file iboa.events (liaison xpark.#)
activate RC
RC -> PL : evenement brut
activate PL
PL -> SC : notation
activate SC
SC -> SC : score de base selon le type
SC -> SC : modificateurs\n(contexte, impact, frequence, severite)
SC --> PL : criticite\nCRITIQUE >=85 / IMPORTANT 60-84\n/ NORMAL 30-59 / INFO <30
deactivate SC
PL -> AG : regroupement des evenements lies
PL -> ST : enregistrement du journal
ST -> PG : INSERT
alt Criticite suffisante
  PL -> FM : mise en forme metier
  FM --> PL : message lisible
  PL -> DL : diffusion
  alt SMTP configure
    DL -> DL : send_email (smtplib)
  end
  alt Twilio configure
    DL -> DL : send_whatsapp (API Twilio)
  end
end
deactivate PL
deactivate RC

A -> BO : ouvre /monitoring/iboa
BO -> ST : GET /events
ST --> BO : evenements notes
BO -> A : journal en langage metier

@enduml
