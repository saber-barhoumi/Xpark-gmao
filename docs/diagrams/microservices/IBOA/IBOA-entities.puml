@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IBOA - Entites du domaine

hide empty methods
skinparam linetype ortho

note as N
  Service Python : les structures de donnees sont des modeles
  Pydantic, pas des entites persistees par un ORM.
end note

class "BusinessEvent" as BusinessEvent <<Pydantic>>
class "ScoredEvent" as ScoredEvent <<Pydantic>>
class "Alert" as Alert <<Pydantic>>
class "OwnerPreferences" as OwnerPreferences <<Pydantic>>
class "TestEventRequest" as TestEventRequest <<Pydantic>>
class "DeleteIdsRequest" as DeleteIdsRequest <<Pydantic>>

@enduml
