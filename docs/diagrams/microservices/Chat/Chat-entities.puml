@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

title Chat - Modele du domaine

class Conversation <<entity>> {
  -idConversation : Long {id}
  -titre : String
  -typeConversation : TypeConversation
  -dateCreation : Date
  -dernierMessageDate : Date
  -imageGroupe : String
  -estArchivee : Boolean
}
class ConversationParticipant <<entity>> {
  -idParticipant : Long {id}
  -dateAjout : Date
  -estAdmin : Boolean
  -estEpingle : Boolean
  -derniereLecture : Date
  -notificationsActivees : Boolean
  -pseudonyme : String
}
class Message <<entity>> {
  -idMessage : Long {id}
  -contenu : String
  -dateEnvoi : Date
  -typeMessage : TypeMessage
  -estLu : Boolean
  -dateLecture : Date
  -estSupprime : Boolean
  -estModifie : Boolean
  -dateModification : Date
  -epingle : Boolean
  -cheminFichier : String
  -nomFichier : String
  -tailleFichier : Long
}
enum TypeConversation <<enumeration>> {
  PRIVEE
  GROUPE
}
enum TypeMessage <<enumeration>> {
  TEXTE
  IMAGE
  FICHIER
  AUDIO
  VIDEO
  SYSTEME
  APPEL
}

Conversation "1" *-- "0..*" Message : echanges >
Conversation "1" *-- "2..*" ConversationParticipant : participants >
Conversation ..> TypeConversation : << use >>
Message ..> TypeMessage : << use >>

@enduml
