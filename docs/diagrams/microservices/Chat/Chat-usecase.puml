@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
left to right direction

title Diagramme de cas d'utilisation - Chat

' Acteurs principaux, empiles a gauche du plus general au plus specialise
actor "Utilisateur" as Utilisateur
actor "Employe" as Employe
actor "Administrateur" as Administrateur
actor "Gestionnaire" as Gestionnaire
actor "Technicien" as Technicien
actor "Chauffeur" as Chauffeur
actor "Client" as Client

' Generalisation : triangle creux, de l'enfant vers le parent
Employe -up-|> Utilisateur
Client -up-|> Utilisateur
Administrateur -up-|> Employe
Gestionnaire -up-|> Employe
Technicien -up-|> Employe
Chauffeur -up-|> Employe

rectangle "Service Messagerie" {
  usecase "Consulter ses conversations" as UC_Consulter_ses_conversations
  usecase "Ouvrir une conversation privee" as UC_Ouvrir_une_conversation_privee
  usecase "Creer un groupe de discussion" as UC_Creer_un_groupe_de_discussion
  usecase "Archiver une conversation" as UC_Archiver_une_conversation
  usecase "Consulter les conversations archivees" as UC_Consulter_les_conversations_archiv
  usecase "Couper les notifications" as UC_Couper_les_notifications
  usecase "Consulter les messages" as UC_Consulter_les_messages
  usecase "Envoyer un message" as UC_Envoyer_un_message
  usecase "Joindre un fichier" as UC_Joindre_un_fichier
  usecase "Epingler un message" as UC_Epingler_un_message
  usecase "Transferer un message" as UC_Transferer_un_message
  usecase "Supprimer un message" as UC_Supprimer_un_message
  usecase "Consulter les correspondants connectes" as UC_Consulter_les_correspondants_conne
  usecase "Rechercher un correspondant" as UC_Rechercher_un_correspondant
  usecase "Supprimer une conversation" as UC_Supprimer_une_conversation
}

' Associations : trait continu sans fleche (relation d'association)
Utilisateur -- UC_Consulter_ses_conversations
Utilisateur -- UC_Ouvrir_une_conversation_privee
Utilisateur -- UC_Creer_un_groupe_de_discussion
Utilisateur -- UC_Archiver_une_conversation
Utilisateur -- UC_Consulter_les_conversations_archiv
Utilisateur -- UC_Couper_les_notifications
Utilisateur -- UC_Consulter_les_messages
Utilisateur -- UC_Envoyer_un_message
Utilisateur -- UC_Epingler_un_message
Utilisateur -- UC_Transferer_un_message
Utilisateur -- UC_Supprimer_un_message
Utilisateur -- UC_Consulter_les_correspondants_conne
Utilisateur -- UC_Rechercher_un_correspondant
Administrateur -- UC_Supprimer_une_conversation

' << extend >> : du cas optionnel vers le cas de base
UC_Joindre_un_fichier ..> UC_Envoyer_un_message : << extend >>

@enduml
