@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

skinparam componentStyle rectangle

actor "Client du service" as CLIENT

package "Couche Presentation (API)" as P_API {
  component "InterventionsController\n<<control>>" as CTRL
  component "Reponse applicative\n<<value object>>" as RESP
}

package "Couche Application" as P_APP {
  interface "IMaintenanceService" as IMaintenanceService
  component "Objets de transfert (DTO)" as DTO
}

package "Couche Domaine" as P_DOM {
  component "Attachment\nCommentaire\nHistoriqueStatutOT\nIntervention" as ENT
}

package "Couche Infrastructure" as P_INF {
  component "MaintenanceService\n<<service>>" as MaintenanceService
  component "MaintenanceDbContext\n<<repository>>" as CTX
}

database "Base de donnees" as BD

' Flux de la demande, puis retour par le controleur
CLIENT --> CTRL : demande
CTRL --> CLIENT : reponse
CTRL ..> IMaintenanceService : << use >>
CTRL ..> RESP : << use >>
RESP ..> DTO : << use >>

' Inversion de dependance : l'Infrastructure realise les contrats
' declares par l'Application. Aucune fleche ne part de l'Application
' vers l'Infrastructure.
MaintenanceService ..|> IMaintenanceService

MaintenanceService ..> ENT : << use >>
CTX ..> ENT : << use >>
MaintenanceService ..> CTX : << use >>
CTX --> BD

P_APP ..> P_DOM : << use >>

note bottom of P_APP
  Les dependances pointent toutes vers l'interieur :
  Presentation et Infrastructure dependent de l'Application,
  l'Application depend du Domaine, le Domaine ne depend de rien.
end note

@enduml
