@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Maintenance - Entites du domaine

hide empty methods
skinparam linetype ortho

entity "Attachment" as Attachment {
  Id : long <<PK>>
  OrdreId : long <<FK>>
  Nom : string
  Url : string
  Taille : long
  Type : string
  CreatedAt : DateTime
}
entity "Commentaire" as Commentaire {
  Id : long <<PK>>
  OrdreId : long <<FK>>
  Contenu : string
  AuteurId : long <<FK>>
  CreatedAt : DateTime
}
entity "HistoriqueStatutOT" as HistoriqueStatutOT {
  Id : long <<PK>>
  OrdreTravailId : long <<FK>>
  AncienStatut : string
  NouveauStatut : string
  Commentaire : string?
  UtilisateurId : long? <<FK>>
  DateChangement : DateTime
}
entity "Intervention" as Intervention {
  IdIntervention : long <<PK>>
  DateIntervention : DateTime
  DateFinIntervention : DateTime?
  TypeIntervention : TypeIntervention
  Description : string
  Cout : double
  CoutMainOeuvre : double?
  CoutPieces : double?
  Statut : StatutIntervention
  KilometrageIntervention : double
  Observations : string?
  Prestataire : string?
  DureeMinutes : int?
  TypePeriodicite : string?
  VehiculeId : long <<FK>>
  TechnicienId : long? <<FK>>
  OrdreTravailId : long? <<FK>>
  DateCreation : DateTime
}
entity "InterventionPiece" as InterventionPiece {
  IdInterventionPiece : long <<PK>>
  InterventionId : long <<FK>>
  PieceId : long <<FK>>
  Quantite : int
  PrixUnitaire : double
}
entity "OrdreTravail" as OrdreTravail {
  IdOrdreTravail : long <<PK>>
  Reference : string
  DateCreation : DateTime
  DateDebut : DateTime?
  DateFin : DateTime?
  Description : string
  Statut : StatutOrdreTravail
  Priorite : PrioriteOrdreTravail
  CoutReel : double?
  Observations : string?
  MotifAnnulation : string?
  ValideParId : long? <<FK>>
  DateValidation : DateTime?
  VehiculeId : long <<FK>>
  TechnicienId : long? <<FK>>
}
entity "PieceRechange" as PieceRechange {
  IdPiece : long
  Reference : string
  Designation : string
  Categorie : CategoriePiece
  StockActuel : int
  StockMinimum : int
  StockMaximum : int
  PrixUnitaire : double
  Fournisseur : string?
  Emplacement : string?
  Description : string?
  ImageUrl : string?
  Actif : bool
  DateCreation : DateTime
  DateDernierApprovisionnement : DateTime?
}
enum TypeIntervention {
  PREVENTIVE
  CURATIVE
}
enum StatutIntervention {
  EN_ATTENTE
  PLANIFIEE
  EN_COURS
  TERMINEE
  ANNULEE
}
enum StatutOrdreTravail {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}
enum PrioriteOrdreTravail {
  BASSE
  MOYENNE
  HAUTE
  URGENT
}
enum StatutVehicule {
  DISPONIBLE
  EN_MAINTENANCE
  EN_MISSION
  HORS_SERVICE
  BESOIN_MAINTENANCE
}
enum CategoriePiece {
  MOTEUR
  TRANSMISSION
  FREINAGE
  SUSPENSION
  ELECTRICITE
  CARROSSERIE
  PNEUMATIQUE
  FILTRATION
  ECLAIRAGE
  AUTRE
}
enum Role {
  ADMIN
  ADMINISTRATEUR
  GESTIONNAIRE
  TECHNICIEN
  CHAUFFEUR
  CLIENT
}
enum StatutUtilisateur {
  EN_ATTENTE
  ACTIF
  SUSPENDU
  DESACTIVE
}

Attachment "0..*" --> "1" OrdreTravail : OrdreTravail
Commentaire "0..*" --> "1" OrdreTravail : OrdreTravail
HistoriqueStatutOT "0..*" --> "1" OrdreTravail : OrdreTravail
Intervention "0..*" --> "1" OrdreTravail : OrdreTravail
Intervention "1" *-- "0..*" InterventionPiece : InterventionPieces
InterventionPiece "0..*" --> "1" Intervention : Intervention
InterventionPiece "0..*" --> "1" PieceRechange : Piece
OrdreTravail "1" *-- "0..*" Intervention : Interventions
OrdreTravail "1" *-- "0..*" Attachment : Attachments
OrdreTravail "1" *-- "0..*" Commentaire : Commentaires
OrdreTravail "1" *-- "0..*" HistoriqueStatutOT : HistoriqueStatuts
PieceRechange "1" *-- "0..*" InterventionPiece : InterventionPieces

legend right
7 entites mappees, 8 enumerations locales.
Certaines entites (Vehicule, Utilisateur, Mission...) sont des
projections en LECTURE SEULE de tables appartenant a un autre
service : la base xpark_gmao est partagee.
endlegend

@enduml
