@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Maintenance - Cas d'utilisation

left to right direction

:ADMIN: as ADMIN
:GESTIONNAIRE: as GESTIONNAIRE
:TECHNICIEN: as TECHNICIEN

rectangle "Maintenance" {
  package "Interventions" {
    usecase "GetAll\nGET /" as InterventionsControllerGetAllGET
    usecase "GetById\nGET {id:long}" as InterventionsControllerGetByIdGET
    usecase "Create\nPOST /" as InterventionsControllerCreatePOST
    usecase "Update\nPUT {id:long}" as InterventionsControllerUpdatePUT
    usecase "UpdateStatut\nPATCH {id:long}/statut" as InterventionsControllerUpdateStatutPATCH
    usecase "AddPiece\nPOST {id:long}/pieces" as InterventionsControllerAddPiecePOST
    usecase "RemovePiece\nDELETE {id:long}/pieces/{pieceId:long}" as InterventionsControllerRemovePieceDELETE
    usecase "Delete\nDELETE {id:long}" as InterventionsControllerDeleteDELETE
  }
  package "OrdreTravail" {
    usecase "GetAll\nGET /" as OrdreTravailControllerGetAllGET
    usecase "GetById\nGET {id:long}" as OrdreTravailControllerGetByIdGET
    usecase "Create\nPOST /" as OrdreTravailControllerCreatePOST
    usecase "Update\nPUT {id:long}" as OrdreTravailControllerUpdatePUT
    usecase "Valider\nPATCH {id:long}/valider" as OrdreTravailControllerValiderPATCH
    usecase "GetHistorique\nGET {id:long}/historique" as OrdreTravailControllerGetHistoriqueGET
    usecase "Delete\nDELETE {id:long}" as OrdreTravailControllerDeleteDELETE
    usecase "GetKanban\nGET kanban" as OrdreTravailControllerGetKanbanGET
    usecase "GetKanbanMetadata\nGET kanban/metadata" as OrdreTravailControllerGetKanbanMetadataGET
    usecase "UpdateStatut\nPUT {id:long}/statut" as OrdreTravailControllerUpdateStatutPUT
    usecase "ClearSection\nDELETE kanban/clear/{statut}" as OrdreTravailControllerClearSectionDELETE
    usecase "GetDetail\nGET {id:long}/detail" as OrdreTravailControllerGetDetailGET
    usecase "... 4 autres actions" as OrdreTravailControllerreste
  }
  package "PiecesRechange" {
    usecase "GetAll\nGET /" as PiecesRechangeControllerGetAllGET
    usecase "GetById\nGET {id:long}" as PiecesRechangeControllerGetByIdGET
    usecase "GetStockFaible\nGET stock-faible" as PiecesRechangeControllerGetStockFaibleGET
    usecase "Create\nPOST /" as PiecesRechangeControllerCreatePOST
    usecase "AjouterStock\nPOST {id:long}/stock" as PiecesRechangeControllerAjouterStockPOST
    usecase "Update\nPUT {id:long}" as PiecesRechangeControllerUpdatePUT
    usecase "Delete\nDELETE {id:long}" as PiecesRechangeControllerDeleteDELETE
    usecase "UploadImage\nPOST upload" as PiecesRechangeControllerUploadImagePOST
  }
}

