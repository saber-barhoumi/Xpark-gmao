@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title AI-Predictor - Flux d'inference

skinparam ActivityBackgroundColor #FCE4EC

start
:Chargement unique du modele\n(joblib, au demarrage);
:Requete entrante;
:Vectorisation des caracteristiques;
:model.predict();
:Post-traitement (fourchette);
:Reponse;
stop

@enduml
