@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title AI-Predictor - Chaine d'apprentissage automatique

skinparam componentStyle rectangle

package "Hors depot (non versionne)" #FFEBEE {
  component "Jeu de donnees d'entrainement" as DS
  component "Entrainement XGBoost" as TR
}
package "Versionne dans le depot" #FCE4EC {
  artifact "model_xgboost.pkl" as MD
  artifact "distance_matrix.json" as DM
  component "main.py (FastAPI)" as API
}
package "Collecte pour un futur reentrainement" #E8F5E9 {
  component "XparkGMAO.Shared.AiTelemetry\nAiDataCollectorService" as COL
  database "AiTripTrainingData" as TD
}

DS --> TR
TR --> MD : joblib.dump
MD --> API : joblib.load au demarrage
DM --> API
COL --> TD : missions terminees
TD ..> DS : alimenterait un reentrainement

@enduml
