@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title AI-Predictor - Cas d'utilisation

left to right direction

:GESTIONNAIRE: as GESTIONNAIRE
:CLIENT: as CLIENT

rectangle "AI-Predictor" {
  package "API FastAPI" {
    usecase "health\nGET /health" as healthGET
    usecase "get_cities\nGET /cities" as get_citiesGET
    usecase "get_distance\nGET /distance" as get_distanceGET
    usecase "predict\nPOST /predict" as predictPOST
  }
}

GESTIONNAIRE --> healthGET
GESTIONNAIRE --> get_citiesGET
GESTIONNAIRE --> get_distanceGET
GESTIONNAIRE --> predictPOST

legend right
Service interne : il n'expose pas de RBAC propre, l'acces est
filtre en amont (passerelle ou service appelant).
endlegend

@enduml
