@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
left to right direction

title Diagramme de cas d'utilisation - AI-Predictor

' Acteurs principaux (a gauche)
actor "Utilisateur" as Utilisateur
actor "Gestionnaire" as Gestionnaire
actor "Client" as Client

Utilisateur <|-- Gestionnaire
Utilisateur <|-- Client

rectangle "Service Estimation Tarifaire" {
  usecase "Estimer le prix du trajet" as UC_Estimer_le_prix_du_trajet
  usecase "Consulter les villes desservies" as UC_Consulter_les_villes_desservies
  usecase "Calculer la distance du trajet" as UC_Calculer_la_distance_du_trajet
  usecase "Appliquer le modele de prediction" as UC_Appliquer_le_modele_de_prediction
  usecase "Verifier la disponibilite du service" as UC_Verifier_la_disponibilite_du_servi
}

' Acteurs secondaires (a droite, hors frontiere)
actor "Modele XGBoost pre-entraine" as Modele

' Associations : trait continu sans fleche (UML : relation d'association)
Utilisateur -- UC_Estimer_le_prix_du_trajet
Gestionnaire -- UC_Consulter_les_villes_desservies
Gestionnaire -- UC_Verifier_la_disponibilite_du_servi

Modele -- UC_Appliquer_le_modele_de_prediction : << secondary >>

UC_Estimer_le_prix_du_trajet ..> UC_Calculer_la_distance_du_trajet : << include >>
UC_Estimer_le_prix_du_trajet ..> UC_Appliquer_le_modele_de_prediction : << include >>

@enduml
