@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title AI-Predictor - Diagramme d'etats

skinparam state {
  BackgroundColor #F5F7FA
  BorderColor #78909C
}

[*] --> Demarrage
Demarrage --> Pret : model_xgboost.pkl et\ndistance_matrix.json charges
Pret --> Inference : POST /predict
Inference --> Pret : prix retourne
Inference --> Erreur : ville inconnue\nou corps invalide
Erreur --> Pret
Pret --> [*] : arret du conteneur

legend right
Service sans etat entre deux requetes : seuls les artefacts
sont conserves en memoire.
endlegend

@enduml
