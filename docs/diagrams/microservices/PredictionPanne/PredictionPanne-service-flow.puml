@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

title PredictionPanne - Chaine interne en couches

skinparam componentStyle rectangle

actor "Client du service" as CLIENT

package "Couche Presentation (API)" as P_API {
  component "PredictionsController\n<<control>>" as CTRL
  component "Reponse applicative\n<<value object>>" as RESP
}

package "Couche Application" as P_APP {
  interface "IPredictionEngine" as IPredictionEngine
  interface "IPredictionService" as IPredictionService
  component "Objets de transfert (DTO)" as DTO
}

package "Couche Domaine" as P_DOM {
  component "Prediction\nVehiculeRef\nInterventionRef" as ENT
}

package "Couche Infrastructure" as P_INF {
  component "RuleBasedPredictionEngine\n<<service>>" as RuleBasedPredictionEngine
  component "PredictionService\n<<service>>" as PredictionService
  component "PredictionDbContext\n<<repository>>" as CTX
}

database "Base de donnees" as BD

' Flux de la demande, puis retour par le controleur
CLIENT --> CTRL : demande
CTRL --> CLIENT : reponse
CTRL ..> IPredictionEngine : << use >>
CTRL ..> RESP : << use >>
RESP ..> DTO : << use >>

' Inversion de dependance : l'Infrastructure realise les contrats
' declares par l'Application. Aucune fleche ne part de l'Application
' vers l'Infrastructure.
RuleBasedPredictionEngine ..|> IPredictionEngine
PredictionService ..|> IPredictionService

RuleBasedPredictionEngine ..> ENT : << use >>
PredictionService ..> ENT : << use >>
CTX ..> ENT : << use >>
RuleBasedPredictionEngine ..> CTX : << use >>
CTX --> BD

P_APP ..> P_DOM : << use >>

note bottom of P_APP
  Les dependances pointent toutes vers l'interieur :
  Presentation et Infrastructure dependent de l'Application,
  l'Application depend du Domaine, le Domaine ne depend de rien.
end note

@enduml
