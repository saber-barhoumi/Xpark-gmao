@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title PredictionPanne - Diagramme de classes

hide empty members

package "PredictionPanne.API" #E1F5FE {
  class PredictionsController {
    <<Route api/predictions>>
    +GetDashboard() : GET dashboard
    +GetSanteFlotte() : GET sante
    +GetSanteVehicule() : GET sante/{vehiculeId:long}
    +GetHistorique() : GET historique/{vehiculeId:long}
    +GetHistoriqueGlobal() : GET historique
    +SupprimerPrediction() : DELETE historique/{id:long}
    +SupprimerLot() : POST historique/supprimer
    +Recalculer() : POST recalculer
  }
}
package "PredictionPanne.Application" #FFF3E0 {
  interface IPredictionEngine
  interface IPredictionService
}
package "PredictionPanne.Domain" #E8F5E9 {
  class Prediction <<entite>>
  class VehiculeRef <<entite>>
  class InterventionRef <<entite>>
}
package "PredictionPanne.Infrastructure" #FFF8E1 {
  class PredictionDbContext <<DbContext>>
  class RuleBasedPredictionEngine
  class PredictionService
}

RuleBasedPredictionEngine ..|> IPredictionEngine
PredictionService ..|> IPredictionService
PredictionsController --> IPredictionService : injection
PredictionService --> IPredictionEngine
PredictionService --> PredictionDbContext
PredictionDbContext --> Prediction : DbSet
PredictionDbContext --> VehiculeRef : DbSet
PredictionDbContext --> InterventionRef : DbSet

legend right
1 controleurs, 2 interfaces, 2 implementations, 3 entites.
Les dependances proviennent des constructeurs primaires C# 12
reellement declares dans le code.
endlegend

@enduml
