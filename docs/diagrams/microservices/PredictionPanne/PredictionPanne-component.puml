@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title PredictionPanne - Diagramme de composants

skinparam componentStyle rectangle

component "backoffice (React)" as BO #E1F5FE
component "nginx (passerelle)" as GWc #ECEFF1

package "conteneur prediction-api (:5009)" #E8F5E9 {
  package "API" {
    component "PredictionsController" as PredictionsController
  }
  package "Application (ports)" {
    interface "IPredictionEngine" as IPredictionEngine
    interface "IPredictionService" as IPredictionService
  }
  package "Infrastructure (adaptateurs)" {
    component "RuleBasedPredictionEngine" as RuleBasedPredictionEngine
    component "PredictionService" as PredictionService
    component "PredictionDbContext" as PredictionDbContext
  }
}

database "postgres\nxpark_gmao" as PG #FFF8E1
queue "rabbitmq" as MQ #ECEFF1

BO --> GWc
GWc --> PredictionsController
GWc --> PredictionsController
RuleBasedPredictionEngine ..|> IPredictionEngine
PredictionService ..|> IPredictionService
PredictionDbContext --> PG
RuleBasedPredictionEngine --> PredictionDbContext
PredictionService --> PredictionDbContext

legend right
Port publie : 5009 (le processus ecoute sur le port 80 dans le reseau Docker).
endlegend

@enduml
