@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title PredictionPanne - Persistance

skinparam linetype ortho
hide circle

database "postgres : xpark_gmao" {
  package "Accede par PredictionDbContext" #FFF8E1 {
    entity "Interventions" as InterventionRef {
      IdIntervention : long
      DateIntervention : DateTime
      TypeIntervention : string
      Description : string
      Cout : double
      KilometrageIntervention : double
      Statut : string
      VehiculeId : long
    }
    entity "Predictions" as Prediction {
      IdPrediction : long
      VehiculeId : long
      TypePanne : TypePanne
      NiveauRisque : NiveauRisque
      Probabilite : double
      ScoreConfiance : double
      DatePanneEstimee : DateTime?
      DateMaintenanceRecommandee : DateTime?
      DureeVieRestanteJours : int?
      KilometrageRestant : double?
      PieceARemplacer : string?
      Explication : string
      Recommandation : string
      Source : SourcePrediction
      VersionModele : string
      DateCalcul : DateTime
    }
    entity "Vehicules" as VehiculeRef {
      IdVehicule : long
      Immatriculation : string
      Marque : string
      Modele : string
      AnneeConstruction : int
      Kilometrage : double
      Actif : bool
      DateDerniereRevision : DateTime?
      DateProchaineRevision : DateTime?
    }
  }
}

note as N
  DbContext : PredictionDbContext
  3 DbSet declares.
  Fournisseur : Npgsql (PostgreSQL 16).
end note

legend right
Base unique partagee : ce service ecrit dans ses tables et lit
celles des autres domaines en SQL direct lorsque necessaire.
endlegend

@enduml
