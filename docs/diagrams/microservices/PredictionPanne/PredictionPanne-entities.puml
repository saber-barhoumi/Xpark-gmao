@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

title PredictionPanne - Modele du domaine

class Prediction <<entity>> {
  -idPrediction : Long {id}
  -typePanne : TypePanne
  -niveauRisque : NiveauRisque
  -probabilite : Double
  -scoreConfiance : Double
  -datePanneEstimee : Date
  -dateMaintenanceRecommandee : Date
  -dureeVieRestanteJours : Integer
  -kilometrageRestant : Double
  -pieceARemplacer : String
  -explication : String
  -recommandation : String
  -source : SourcePrediction
  -versionModele : String
  -dateCalcul : Date
  -realisee : Boolean
  -dateVerification : Date
}
enum NiveauRisque <<enumeration>> {
  FAIBLE
  MODERE
  ELEVE
  CRITIQUE
}
enum TypePanne <<enumeration>> {
  MOTEUR
  FREINS
  PNEUMATIQUES
  TRANSMISSION
  SUSPENSION
  ELECTRIQUE
  REFROIDISSEMENT
  CLIMATISATION
  AUTRE
}
enum SourcePrediction <<enumeration>> {
  REGLES
  MODELE_ML
}

Prediction ..> NiveauRisque : << use >>
Prediction ..> SourcePrediction : << use >>
Prediction ..> TypePanne : << use >>

@enduml
