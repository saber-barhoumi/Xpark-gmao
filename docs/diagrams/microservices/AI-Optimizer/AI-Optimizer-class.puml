@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title AI-Optimizer - Diagramme de classes

hide empty members

package "constraints.py" #FCE4EC {
  class "constraints.py" as modconstraints_py <<module>> {
    +vehicle_class()
    +class_ok()
    +license_ok()
    +maintenance_ok()
    +mission_duration_min()
    +mission_interval()
    +overlaps()
    +schedule_ok()
    +hours_ok()
  }
}
package "main.py" #FCE4EC {
  class "main.py" as modmain_py <<module>> {
    +startup()
    +health()
    +run_optimization()
  }
}
package "models.py" #FCE4EC {
  class "MissionIn" as MissionIn <<Pydantic>> {
  }
  class "VehicleIn" as VehicleIn <<Pydantic>> {
  }
  class "DriverIn" as DriverIn <<Pydantic>> {
  }
  class "RecentMission" as RecentMission <<Pydantic>> {
  }
  class "OptimizationConstraints" as OptimizationConstraints <<Pydantic>> {
  }
  class "OptimizeRequest" as OptimizeRequest <<Pydantic>> {
  }
  class "AssignmentOut" as AssignmentOut <<Pydantic>> {
  }
  class "UnassignedOut" as UnassignedOut <<Pydantic>> {
  }
  class "MetricsOut" as MetricsOut <<Pydantic>> {
  }
  class "OptimizeResponse" as OptimizeResponse <<Pydantic>> {
  }
}
package "optimizer.py" #FCE4EC {
  class "OptimizationContext" as OptimizationContext <<classe>> {
  }
  class "optimizer.py" as modoptimizer_py <<module>> {
    +greedy()
    +genetic()
    +local_search()
    +build_reasoning()
    +unassignment_reason()
    +optimize()
  }
}
package "rabbitmq_consumer.py" #FCE4EC {
  class "rabbitmq_consumer.py" as modrabbitmq_consumer_py <<module>> {
    +start_consumer_thread()
  }
}
package "scoring.py" #FCE4EC {
  class "GlobalScorer" as GlobalScorer <<classe>> {
  }
  class "scoring.py" as modscoring_py <<module>> {
    +fuel_consumption()
    +fuel_cost()
    +preference_score()
    +workload_balance_score()
    +workload_stdev()
  }
}

legend right
2 classes, 10 modeles Pydantic et 24 fonctions publiques
reparties sur 6 modules.
endlegend

@enduml
