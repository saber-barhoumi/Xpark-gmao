@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
left to right direction

' Acteurs, alignes a gauche : les porteurs d'associations sont
' accoles a la frontiere, les acteurs structurels a leur gauche
actor "Utilisateur" as Utilisateur
actor "Employe" as Employe
actor "Gestionnaire" as Gestionnaire

' Generalisation : triangle creux, de l'enfant vers le parent
Employe -down-|> Utilisateur
Gestionnaire -up-|> Employe

rectangle "Service Optimisation de Flotte" {
  package "Optimisation" {
    usecase "Optimiser une affectation" as UC_Optimiser_une_affectation
  }
  package "Exploitation" {
    usecase "Verifier la disponibilite du service" as UC_Verifier_la_disponibilite_du_servi
  }
  usecase "Appliquer les contraintes d'affectation" as UC_Appliquer_les_contraintes_d_affect
  usecase "Noter les candidats" as UC_Noter_les_candidats
  usecase "Produire un plan d'affectation" as UC_Produire_un_plan_d_affectation
}

' Acteurs secondaires, a droite, hors de la frontiere
actor "Bus de messages" as Bus

' Associations : trait continu sans fleche (relation d'association)
Utilisateur -- UC_Optimiser_une_affectation
Gestionnaire -- UC_Verifier_la_disponibilite_du_servi

UC_Optimiser_une_affectation -down- Bus
UC_Produire_un_plan_d_affectation -down- Bus

' << include >> : du cas de base vers le cas obligatoire
UC_Optimiser_une_affectation ..> UC_Appliquer_les_contraintes_d_affect : << include >>
UC_Optimiser_une_affectation ..> UC_Noter_les_candidats : << include >>
UC_Optimiser_une_affectation ..> UC_Produire_un_plan_d_affectation : << include >>

@enduml
