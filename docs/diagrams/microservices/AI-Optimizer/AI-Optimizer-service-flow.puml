@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

title AI-Optimizer - Chaine interne en couches

skinparam componentStyle rectangle

package "Presentation" {
  component "Point d'entree du service" as ENTREE
}
package "Traitement" {
  component "constraints.py" as constraints_py
  component "main.py" as main_py
  component "models.py" as models_py
  component "optimizer.py" as optimizer_py
  component "rabbitmq_consumer.py" as rabbitmq_consumer_py
  component "scoring.py" as scoring_py
}

ENTREE --> constraints_py
constraints_py --> main_py
main_py --> models_py
models_py --> optimizer_py
optimizer_py --> rabbitmq_consumer_py
rabbitmq_consumer_py --> scoring_py

@enduml
