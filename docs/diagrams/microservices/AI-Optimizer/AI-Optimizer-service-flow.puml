skinparam componentStyle rectangle

title AI-Optimizer - Chaine interne (couches)

skinparam componentStyle rectangle

rectangle "main.py / rabbitmq_consumer.py" as A #FCE4EC
rectangle "models.py\nschemas Pydantic" as B #FCE4EC
rectangle "constraints.py\ncontraintes d'affectation" as C #FCE4EC
rectangle "scoring.py\nnotation des candidats" as D #FCE4EC
