@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

title Diagramme de classes de conception - Architecture - AI-Optimizer

package "OptimisateurFlotteIA" {
  class "constraints" as constraints_py <<module>> {
    +vehicle_class()
    +class_ok()
    +license_ok()
    +maintenance_ok()
    +mission_duration_min()
    +mission_interval()
    +overlaps()
    +schedule_ok()
    +... 1 autres operations
  }
  class "main" as main_py <<module>> {
    +startup()
    +health()
    +run_optimization()
  }
  class "optimizer" as optimizer_py <<module>> {
    +greedy()
    +genetic()
    +local_search()
    +build_reasoning()
    +unassignment_reason()
    +optimize()
  }
  class OptimizationContext <<service>>
  class "rabbitmq_consumer" as rabbitmq_consumer_py <<module>> {
    +start_consumer_thread()
  }
  class "scoring" as scoring_py <<module>> {
    +fuel_consumption()
    +fuel_cost()
    +preference_score()
    +workload_balance_score()
    +workload_stdev()
  }
  class GlobalScorer <<service>>
}

constraints_py ..> models_py : << use >>
main_py ..> models_py : << use >>
main_py ..> optimizer_py : << use >>
main_py ..> rabbitmq_consumer_py : << use >>
optimizer_py ..> constraints_py : << use >>
optimizer_py ..> models_py : << use >>
optimizer_py ..> scoring_py : << use >>
rabbitmq_consumer_py ..> models_py : << use >>
rabbitmq_consumer_py ..> optimizer_py : << use >>
scoring_py ..> constraints_py : << use >>
scoring_py ..> models_py : << use >>
optimizer_py ..> OptimizationContext : << use >>
scoring_py ..> GlobalScorer : << use >>

@enduml
