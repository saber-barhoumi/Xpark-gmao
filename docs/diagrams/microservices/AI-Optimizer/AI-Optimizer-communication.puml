@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title AI-Optimizer - Communications

skinparam componentStyle rectangle

component "**ai-optimizer**" as ME #E8F5E9

component "backoffice" as BO #E1F5FE
component "nginx" as GWc #ECEFF1
database "postgres" as PG #FFF8E1
queue "rabbitmq" as MQ #ECEFF1

component "mission-api" as MS #E8F5E9
MS -[#CC6600]-> MQ : xpark.missions.ready-for-optimization
MQ -[#CC6600]-> ME : file optimizer.ready-for-optimization
ME -[#CC6600]-> MQ : xpark.optimization.plan-generated
MQ -[#CC6600]-> MS : plan disponible
BO -[#0066CC]-> ME : POST /optimize (appel direct)

legend right
Bleu : HTTP · Orange : AMQP · Vert : WebSocket · Gris : base de donnees.
endlegend

@enduml
