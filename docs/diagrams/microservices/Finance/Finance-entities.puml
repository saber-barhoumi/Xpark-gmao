@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

class Facture <<entity>> {
  -idFacture : Long {id}
  -numeroFacture : String
  -dateFacture : Date
  -dateEcheance : Date
  -montant : Double
  -montantTVA : Double
  -montantTTC : Double
  -tauxTVA : Double
  -description : String
  -statut : StatutFacture
  -datePaiement : Date
  -motifAnnulation : String
  -dateCreation : Date
}
enum StatutFacture <<enumeration>> {
  EN_ATTENTE
  BROUILLON
  EMISE
  PAYEE
  ANNULEE
  EN_RETARD
}

Facture ..> StatutFacture : << use >>

@enduml
