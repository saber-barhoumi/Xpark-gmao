@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Finance - Diagramme de classes

hide empty members

package "Finance.API" #E1F5FE {
  class CarburantsController {
    <<Route ->>
  }
  class FacturesController {
    <<Route api/[controller]>>
    +GetAll() : GET /
    +GetById() : GET {id:long}
    +GetByClient() : GET client/{clientId:long}
    +GetMy() : GET my
    +GetImpayees() : GET impayees
    +GetMissionsFacturees() : GET missions-facturees
    +Create() : POST /
    +MarquerPayee() : PATCH {id:long}/payer
    +Annuler() : PATCH {id:long}/annuler
  }
  class SourcesController {
    <<Route ->>
  }
}
package "Finance.Application" #FFF3E0 {
  interface ICarburantService
  interface IFacturationService
  interface IGenericRepository
  interface IFactureRepository
  class FinanceProfile <<AutoMapper Profile>>
}
package "Finance.Domain" #E8F5E9 {
  class Facture <<entite>>
  class UtilisateurRef <<entite>>
  class MissionRef <<entite>>
}
package "Finance.Infrastructure" #FFF8E1 {
  class FinanceDbContext <<DbContext>>
  class FacturationService
}

FacturationService ..|> IFacturationService
FacturesController --> IFacturationService : injection
FacturesController --> ILogger : injection
FacturationService --> IFactureRepository
FacturationService --> FinanceDbContext
FinanceDbContext --> Facture : DbSet
FinanceDbContext --> UtilisateurRef : DbSet
FinanceDbContext --> MissionRef : DbSet

legend right
3 controleurs, 4 interfaces, 1 implementations, 3 entites.
Les dependances proviennent des constructeurs primaires C# 12
reellement declares dans le code.
endlegend

@enduml
