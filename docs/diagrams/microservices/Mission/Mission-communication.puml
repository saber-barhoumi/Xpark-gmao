@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members
skinparam componentStyle rectangle
left to right direction

' 1. Clients
component "backoffice\n<<interface utilisateur>>" as BO #E1F5FE

' 2. Passerelle
component "nginx\n<<passerelle>>" as GW #ECEFF1

' 3. Service
component "mission-api\n<<microservice>>" as API #E8F5E9

' 4. Persistance et messagerie
database "postgres\n<<base de donnees>>" as BD #FFF8E1
queue "rabbitmq\n<<bus de messages>>" as MQ #FFF3E0
component "finance-api\n<<microservice>>" as finance_api #E8F5E9
component "fleet-api\n<<microservice>>" as fleet_api #E8F5E9

' 5. Consommateurs
component "ai-optimizer\n<<consommateur>>" as ai_optimizer #FCE4EC
component "iboa\n<<consommateur>>" as iboa #FCE4EC

' Flux synchrone (HTTP), de gauche a droite
BO --> GW : requete
GW --> API : /mission/
API --> BD : Npgsql
API --> finance_api : appel interne
API --> fleet_api : appel interne

' Flux asynchrone (AMQP) : une seule fleche par famille de cles
API --> MQ : publie xpark.mission.client-request
API --> MQ : publie xpark.mission.task-cancelled
API --> MQ : publie xpark.mission.task-completed
API --> MQ : publie xpark.missions.ready-for-optimization
API --> MQ : publie xpark.optimization.plan-generated
MQ --> ai_optimizer : Moteur d'optimisation
MQ --> iboa : Journal metier

note bottom of API
  Mission publie la demande d'optimisation et consomme en retour
  le plan produit : le sens des deux fleches vers le bus differe.
end note

@enduml
