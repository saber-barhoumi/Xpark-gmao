@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Mission - Communications

skinparam componentStyle rectangle

component "**mission-api**" as ME #E8F5E9

component "backoffice" as BO #E1F5FE
component "nginx" as GWc #ECEFF1
database "postgres" as PG #FFF8E1
queue "rabbitmq" as MQ #ECEFF1

BO -[#0066CC]-> GWc : HTTP
GWc -[#0066CC]-> ME : proxy_pass /mission/
ME -[#666666]-> PG : Npgsql
component "finance-api" as finance_api #E8F5E9
ME -[#0066CC]-> finance_api : HTTP interne
component "fleet-api" as fleet_api #E8F5E9
ME -[#0066CC]-> fleet_api : HTTP interne
ME -[#CC6600]-> MQ : xpark.mission.client-request
ME -[#CC6600]-> MQ : xpark.mission.task-cancelled
ME -[#CC6600]-> MQ : xpark.mission.task-completed
ME -[#CC6600]-> MQ : xpark.missions.ready-for-optimization
ME -[#CC6600]-> MQ : xpark.optimization.plan-generated
component "ai-predictor" as AIP #FCE4EC
ME -[#0066CC]-> AIP : estimation de prix
component "ai-optimizer" as AIO #FCE4EC
MQ -[#CC6600]-> AIO : ready-for-optimization
AIO -[#CC6600]-> MQ : plan-generated

@enduml
