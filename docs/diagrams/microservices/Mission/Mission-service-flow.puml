@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

skinparam componentStyle rectangle

actor "Client du service" as CLIENT

package "Couche Presentation (API)" as P_API {
  component "DataMigrationController\n<<control>>" as CTRL
  component "Reponse applicative\n<<value object>>" as RESP
}

package "Couche Application" as P_APP {
  interface "IOptimizerEventBus" as IOptimizerEventBus
  interface "IHistoricalMigrationService" as IHistoricalMigrationService
  interface "IMissionService" as IMissionService
  component "Objets de transfert (DTO)" as DTO
}

package "Couche Domaine" as P_DOM {
  component "LivePosition\nMission\nSupportTicket\nTransportRequest" as ENT
}

package "Couche Infrastructure" as P_INF {
  component "OptimizerEventBus\n<<service>>" as OptimizerEventBus
  component "HistoricalMigrationService\n<<service>>" as HistoricalMigrationService
  component "MissionService\n<<service>>" as MissionService
  component "MissionDbContext\n<<repository>>" as CTX
}

database "Base de donnees" as BD

' Flux de la demande, puis retour par le controleur
CLIENT --> CTRL : demande
CTRL --> CLIENT : reponse
CTRL ..> IOptimizerEventBus : << use >>
CTRL ..> RESP : << use >>
RESP ..> DTO : << use >>

' Inversion de dependance : l'Infrastructure realise les contrats
' declares par l'Application. Aucune fleche ne part de l'Application
' vers l'Infrastructure.
OptimizerEventBus ..|> IOptimizerEventBus
HistoricalMigrationService ..|> IHistoricalMigrationService
MissionService ..|> IMissionService

OptimizerEventBus ..> ENT : << use >>
HistoricalMigrationService ..> ENT : << use >>
MissionService ..> ENT : << use >>
CTX ..> ENT : << use >>
OptimizerEventBus ..> CTX : << use >>
CTX --> BD

P_APP ..> P_DOM : << use >>

note bottom of P_APP
  Les dependances pointent toutes vers l'interieur :
  Presentation et Infrastructure dependent de l'Application,
  l'Application depend du Domaine, le Domaine ne depend de rien.
end note

@enduml
