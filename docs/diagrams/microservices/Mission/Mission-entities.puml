@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

class LivePosition <<entity>> {
  -idPosition : Long {id}
  -latitude : Double
  -longitude : Double
  -speedKmh : Double
  -heading : Double
  -accuracy : Double
  -recordedAt : Date
  -receivedAt : Date
}
class Mission <<entity>> {
  -idMission : Long {id}
  -dateDepart : Date
  -dateRetour : Date
  -destination : String
  -kilometrageDepart : Double
  -kilometrageRetour : Double
  -statut : StatutMission
  -objetMission : String
  -coutTotal : Double
  -clientIdUtilisateur : Long
  -clientNom : String
  -dateCreation : Date
  -bonCarburantAccorde : Boolean
  -numeroBonCarburant : String
  -verificationDocuments : Boolean
  -carteAutorouteRemise : Boolean
  -vehiculeImmatriculation : String
  -chauffeurNom : String
  -villeDepart : String
  -villeArrivee : String
  -distanceKm : Double
  -coutEstimeAI : Double
  -aiVehiculeTypeUsed : String
}
class TransportRequest <<entity>> {
  -idTransportRequest : Long {id}
  -clientIdUtilisateur : Long
  -clientNom : String
  -dateSouhaitee : Date
  -villeDepart : String
  -villeArrivee : String
  -cargoDescription : String
  -cargoWeightKg : Double
  -passengerCount : Integer
  -vehicleTypeRequested : String
  -distanceKm : Double
  -aiEstimatedPrice : Double
  -aiPriceRangeMin : Double
  -aiPriceRangeMax : Double
  -aiVehicleTypeRecommended : String
  -statut : StatutDemandeTransport
  -finalPrice : Double
  -pricingMethod : MethodePrix
  -adminNote : String
  -quotedByName : String
  -dateQuotationEnvoyee : Date
  -clientCancelReason : String
  -clientRejectionReason : String
  -dateClientReponse : Date
  -dateCreation : Date
  -dateMaj : Date
}
enum StatutMission <<enumeration>> {
  EN_ATTENTE
  EN_COURS
  TERMINEE
  ANNULEE
}
enum StatutDemandeTransport <<enumeration>> {
  PENDING_QUOTATION
  QUOTATION_SENT
  ACCEPTED
  REJECTED
  CANCELLED
}
enum MethodePrix <<enumeration>> {
  AI_PRICE
  MODIFIED
  MANUAL
}

TransportRequest "1" -- "0..1" Mission : devis accepte >
Mission "1" *-- "0..*" LivePosition : trace >
Mission ..> StatutMission : << use >>
TransportRequest ..> MethodePrix : << use >>
TransportRequest ..> StatutDemandeTransport : << use >>

@enduml
