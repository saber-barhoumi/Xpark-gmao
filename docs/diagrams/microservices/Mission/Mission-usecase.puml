@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
left to right direction

title Diagramme de cas d'utilisation - Mission

' Acteurs principaux, empiles verticalement a gauche
actor "Utilisateur" as Utilisateur
actor "Responsable" as Responsable
actor "Administrateur" as Administrateur
actor "Gestionnaire" as Gestionnaire
actor "Chauffeur" as Chauffeur
actor "Client" as Client

' Generalisation : triangle creux, de l'enfant vers le parent
Administrateur -up-|> Responsable
Gestionnaire -up-|> Responsable
Responsable -up-|> Utilisateur
Chauffeur -up-|> Utilisateur
Client -up-|> Utilisateur

rectangle "Service Missions" {
  usecase "Consulter les missions" as UC_Consulter_les_missions
  usecase "Etablir un devis" as UC_Etablir_un_devis
  usecase "Creer une mission" as UC_Creer_une_mission
  usecase "Affecter un vehicule et un chauffeur" as UC_Affecter_un_vehicule_et_un_chauffe
  usecase "Cloturer une mission" as UC_Cloturer_une_mission
  usecase "Annuler une mission" as UC_Annuler_une_mission
  usecase "Optimiser une tournee" as UC_Optimiser_une_tournee
  usecase "Consulter l'historique du trajet" as UC_Consulter_l_historique_du_trajet
  usecase "Repondre a un ticket" as UC_Repondre_a_un_ticket
  usecase "Cloturer un ticket" as UC_Cloturer_un_ticket
  usecase "Transmettre sa position" as UC_Transmettre_sa_position
  usecase "Deposer une demande de transport" as UC_Deposer_une_demande_de_transport
  usecase "Estimer le prix du trajet" as UC_Estimer_le_prix_du_trajet
  usecase "Consulter ses demandes" as UC_Consulter_ses_demandes
  usecase "Modifier sa demande" as UC_Modifier_sa_demande
  usecase "Annuler sa demande" as UC_Annuler_sa_demande
  usecase "Accepter un devis" as UC_Accepter_un_devis
  usecase "Refuser un devis" as UC_Refuser_un_devis
  usecase "Suivre une mission en direct" as UC_Suivre_une_mission_en_direct
  usecase "Ouvrir un ticket de support" as UC_Ouvrir_un_ticket_de_support
}

' Acteurs secondaires, a droite, hors de la frontiere
actor "Moteur d'estimation tarifaire" as Estimateur
actor "Moteur d'optimisation" as Optimiseur

' Associations : trait continu sans fleche (relation d'association)
Utilisateur -- UC_Consulter_les_missions
Responsable -- UC_Etablir_un_devis
Responsable -- UC_Creer_une_mission
Responsable -- UC_Affecter_un_vehicule_et_un_chauffe
Responsable -- UC_Cloturer_une_mission
Responsable -- UC_Annuler_une_mission
Responsable -- UC_Optimiser_une_tournee
Responsable -- UC_Consulter_l_historique_du_trajet
Responsable -- UC_Repondre_a_un_ticket
Administrateur -- UC_Cloturer_un_ticket
Chauffeur -- UC_Transmettre_sa_position
Client -- UC_Deposer_une_demande_de_transport
Client -- UC_Consulter_ses_demandes
Client -- UC_Modifier_sa_demande
Client -- UC_Annuler_sa_demande
Client -- UC_Accepter_un_devis
Client -- UC_Refuser_un_devis
Client -- UC_Suivre_une_mission_en_direct
Client -- UC_Ouvrir_un_ticket_de_support

Estimateur -- UC_Estimer_le_prix_du_trajet : << secondary >>
Optimiseur -- UC_Optimiser_une_tournee : << secondary >>

' << include >> : du cas de base vers le cas obligatoire
UC_Deposer_une_demande_de_transport .[norank].> UC_Estimer_le_prix_du_trajet : << include >>
UC_Accepter_un_devis .[norank].> UC_Creer_une_mission : << include >>
UC_Creer_une_mission .[norank].> UC_Affecter_un_vehicule_et_un_chauffe : << include >>
' << extend >> : du cas optionnel vers le cas de base
UC_Optimiser_une_tournee .[norank].> UC_Affecter_un_vehicule_et_un_chauffe : << extend >>

@enduml
