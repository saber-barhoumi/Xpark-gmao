@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

title Alerts - Modele du domaine

class Alerte <<entity>> {
  -idAlerte : Long {id}
  -message : String
  -dateCreation : Date
  -dateExpiration : Date
  -entiteReference : String
  -titre : String
  -dateLecture : Date
  -dateTraitement : Date
  -donnees : String
}
enum TypeAlerte <<enumeration>> {
  ASSURANCE
  VISITE_TECHNIQUE
  VIGNETTE
  PERMIS_CONDUIRE
  MAINTENANCE
  MAINTENANCE_DUE
  STOCK_FAIBLE
  STOCK_RUPTURE
  CARBURANT
  DOCUMENT_EXPIRE
  VEHICULE_VIGNETTE_PROCHE
  VEHICULE_VIGNETTE_EXPIREE
  VEHICULE_ASSURANCE_EXPIREE
  VEHICULE_ASSURANCE_PROCHE
  VEHICULE_VISITE_TECHNIQUE_EXPIREE
  VEHICULE_VISITE_TECHNIQUE_PROCHE
  VEHICULE_BESOIN_MAINTENANCE
  OT_EN_RETARD
  INTERVENTION_UPCOMING
  EMPLOYE_PERMIS_EXPIRE
  EQUIPEMENT_HORS_SERVICE
  EQUIPEMENT_A_REMPLACER
  GARANTIE_EXPIRANTE
  GARANTIE_EXPIREE
  CONTRAT_EXPIRANT
  ROTATION_FAIBLE
  MISSION_EN_RETARD
  MISSION_SANS_EQUIPEMENTS
  ASSURANCE_EXPIRATION
  VIGNETTE_EXPIRATION
  VISITE_TECHNIQUE_EXPIRATION
  KILOMETRAGE_MAINTENANCE
  MAINTENANCE_REQUISE
  CARBURANT_BAS
  MISSION_RETARD
  PIECE_STOCK_FAIBLE
  FACTURE_IMPAYEE
  MISSION_SANS_AFFECTATION
  AUTRE
}
enum Priorite <<enumeration>> {
  BASSE
  MOYENNE
  HAUTE
  CRITIQUE
}
enum StatutAlerte <<enumeration>> {
  ACTIVE
  LUE
  TRAITEE
  IGNOREE
}

Alerte ..> Priorite : << use >>
Alerte ..> StatutAlerte : << use >>
Alerte ..> TypeAlerte : << use >>

@enduml
