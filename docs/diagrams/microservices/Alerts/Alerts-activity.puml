@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Alerts - Deroulement d'un cycle de controle

skinparam ActivityBackgroundColor #F5F7FA
skinparam ActivityBorderColor #78909C

start
:Declenchement (POST /api/alertes/run-checks);
fork
  :Demandes en attente de devis;
fork again
  :Missions livrees non facturees;
fork again
  :Vehicules hors service;
fork again
  :Stock de pieces sous le minimum;
fork again
  :Equipements hors service;
fork again
  :Comptes en attente d'approbation;
fork again
  :Predictions de panne critiques;
end fork
:Consolidation des anomalies;
while (Anomalie a traiter ?) is (oui)
  :ExisteDejaAsync sur le couple\n(type, entite concernee);
  if (Alerte deja presente ?) then (oui)
    :Ignoree;
  else (non)
    :INSERT Alertes (statut ACTIVE);
  endif
endwhile (non)
:Retour du nombre d'alertes creees;
:Le back-office rafraichit le compteur;
stop

@enduml
