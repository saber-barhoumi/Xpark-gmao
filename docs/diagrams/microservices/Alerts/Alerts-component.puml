@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Alerts - Diagramme de composants

skinparam componentStyle rectangle

component "backoffice (React)" as BO #E1F5FE
component "nginx (passerelle)" as GWc #ECEFF1

package "conteneur alerts-api (:5006)" #E8F5E9 {
  package "API" {
    component "AlertesController" as AlertesController
  }
  package "Application (ports)" {
    interface "IAlertService" as IAlertService
    interface "IGenericRepository" as IGenericRepository
    interface "IAlertRepository" as IAlertRepository
  }
  package "Infrastructure (adaptateurs)" {
    component "AlerteService" as AlerteService
    component "AlertsDbContext" as AlertsDbContext
  }
}

database "postgres\nxpark_gmao" as PG #FFF8E1
queue "rabbitmq" as MQ #ECEFF1

BO --> GWc
GWc --> AlertesController
GWc --> AlertesController
AlerteService ..|> IAlertService
AlertsDbContext --> PG
AlerteService --> AlertsDbContext

@enduml
