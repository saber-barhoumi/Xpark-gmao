@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IAM - Entites du domaine

hide empty methods
skinparam linetype ortho

entity "Chauffeur" as Chauffeur {
  NumeroPermis : string
  DateExpirationPermis : DateTime
  Evaluation : double
  NombreMissionsEffectuees : int
  KilometrageTotal : double
  DateDerniereFormation : DateTime?
}
entity "Client" as Client {
  NomSociete : string?
  SecteurActivite : string?
  Adresse : string?
  Ville : string?
  CodePostal : string?
  Pays : string?
  NumeroFiscal : string?
  SiteWeb : string?
  EstEntreprise : bool
}
entity "Employee" as Employee {
  IdEmployee : long <<PK>>
  Name : string
  Prenom : string
  NumeroMatricule : string
  Telephone : string
  DateEmbauche : DateTime
  Activ : bool
  NumeroPermis : string?
  DateExpirationPermis : DateTime?
}
entity "UserMfaSettings" as UserMfaSettings {
  Id : long <<PK>>
  UserId : long <<FK>>
  AuthenticatorEnabled : bool
  AuthenticatorSecret : string?
  EmailOtpEnabled : bool
  DefaultMethod : string
  CreatedAt : DateTime
  UpdatedAt : DateTime
}
entity "EmailOtp" as EmailOtp {
  Id : long <<PK>>
  UserId : long <<FK>>
  CodeHash : string
  ExpiryTime : DateTime
  IsUsed : bool
  UsedAt : DateTime?
  Attempts : int
  CreatedAt : DateTime
}
entity "LoginHistoryEntry" as LoginHistoryEntry {
  Id : long <<PK>>
  UserId : long <<FK>>
  LoginMethod : string
  MfaMethod : string?
  IpAddress : string?
  UserAgent : string?
  IsSuccessful : bool
  FailureReason : string?
  LoggedInAt : DateTime
}
entity "AuthAuditLog" as AuthAuditLog {
  Id : long <<PK>>
  UserId : long? <<FK>>
  Action : string
  Description : string?
  IpAddress : string?
  CreatedAt : DateTime
}
entity "Utilisateur" as Utilisateur {
  IdUtilisateur : long <<PK>>
  Nom : string
  Prenom : string
  Email : string
  MotDePasse : string
  Telephone : string
  Actif : bool
  DateCreation : DateTime
  Photo : string?
  EmailConfirmed : bool
  EmailConfirmationToken : string?
  EmailConfirmationTokenExpiry : DateTime?
  PasswordResetToken : string?
  PasswordResetTokenExpiry : DateTime?
  Pin : string?
  HasPin : bool
  IsSessionLocked : bool
  SessionLockedAt : DateTime?
  RefreshToken : string?
  RefreshTokenExpiry : DateTime?
  LastLoginAt : DateTime?
  LastLoginIp : string?
  FailedLoginAttempts : int
  AccountLockedUntil : DateTime?
  DateApprobation : DateTime?
  ApprouvePar : long?
  RaisonRejet : string?
  DateModification : DateTime?
}

@enduml
