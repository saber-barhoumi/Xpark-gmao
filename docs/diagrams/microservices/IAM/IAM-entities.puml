@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

class Chauffeur <<entity>> {
  -numeroPermis : String
  -dateExpirationPermis : Date
  -evaluation : Double
  -nombreMissionsEffectuees : Integer
  -kilometrageTotal : Double
  -dateDerniereFormation : Date
}
class Client <<entity>> {
  -nomSociete : String
  -secteurActivite : String
  -adresse : String
  -ville : String
  -codePostal : String
  -pays : String
  -numeroFiscal : String
  -siteWeb : String
  -estEntreprise : Boolean
}
class Employee <<entity>> {
  -idEmployee : Long {id}
  -name : String
  -prenom : String
  -numeroMatricule : String
  -telephone : String
  -dateEmbauche : Date
  -activ : Boolean
  -numeroPermis : String
  -dateExpirationPermis : Date
}
class UserMfaSettings <<entity>> {
  -id : Long {id}
  -authenticatorEnabled : Boolean
  -authenticatorSecret : String
  -emailOtpEnabled : Boolean
  -defaultMethod : String
  -createdAt : Date
  -updatedAt : Date
}
class EmailOtp <<entity>> {
  -id : Long {id}
  -codeHash : String
  -expiryTime : Date
  -isUsed : Boolean
  -usedAt : Date
  -attempts : Integer
  -createdAt : Date
}
class AuthAuditLog <<entity>> {
  -id : Long {id}
  -action : String
  -description : String
  -ipAddress : String
  -createdAt : Date
}
class Utilisateur <<entity>> {
  -idUtilisateur : Long {id}
  -nom : String
  -prenom : String
  -email : String
  -motDePasse : String
  -telephone : String
  -actif : Boolean
  -dateCreation : Date
  -photo : String
  -emailConfirmed : Boolean
  -emailConfirmationToken : String
  -emailConfirmationTokenExpiry : Date
  -passwordResetToken : String
  -passwordResetTokenExpiry : Date
  -pin : String
  -hasPin : Boolean
  -isSessionLocked : Boolean
  -sessionLockedAt : Date
  -refreshToken : String
  -refreshTokenExpiry : Date
  -lastLoginAt : Date
  -lastLoginIp : String
  -failedLoginAttempts : Integer
  -accountLockedUntil : Date
  -dateApprobation : Date
  -approuvePar : Long
  -raisonRejet : String
  -dateModification : Date
}

Utilisateur <|-- Client
Utilisateur <|-- Employee
Employee <|-- Chauffeur
Utilisateur "1" *-- "0..*" AuthAuditLog : journal >
Utilisateur "1" *-- "0..*" EmailOtp : codes >
Utilisateur "1" *-- "0..1" UserMfaSettings : second facteur >

@enduml
