@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members
skinparam componentStyle rectangle
left to right direction

' 1. Clients
component "backoffice\n<<interface utilisateur>>" as BO #E1F5FE

' 2. Passerelle
component "nginx\n<<passerelle>>" as GW #ECEFF1

' 3. Service
component "iam-api\n<<microservice>>" as API #E8F5E9

' 4. Persistance et messagerie
database "postgres\n<<base de donnees>>" as BD #FFF8E1
queue "rabbitmq\n<<bus de messages>>" as MQ #FFF3E0

' 5. Consommateurs
component "chat-api\n<<consommateur>>" as chat_api #FCE4EC

' Flux synchrone (HTTP), de gauche a droite
BO --> GW : requete
GW --> API : /iam/
API --> BD : Npgsql

' Flux asynchrone (AMQP) : une seule fleche par famille de cles
API --> MQ : publie 5 evenements types
MQ --> chat_api : Messagerie

@enduml
