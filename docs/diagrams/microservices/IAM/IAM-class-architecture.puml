package "IAM.Application" as APP {
  interface IAuthService <<interface>> {
    +LoginAsync(dto : LoginRequestDto, ipAddress : string) : Task<AuthResponseDto>
    +RegisterAsync(dto : RegisterRequestDto) : Task<AuthResponseDto>
    +LogoutAsync(userId : long) : Task
    +RefreshTokenAsync(refreshToken : string) : Task<AuthResponseDto>
    +ConfirmEmailAsync(dto : ConfirmEmailDto) : Task
    +RecoverPasswordAsync(dto : RecoverPasswordDto) : Task
    +ResetPasswordAsync(dto : ResetPasswordDto) : Task
    +SetPinAsync(userId : long, dto : SetPinDto) : Task
    +LoginPinAsync(dto : LoginPinDto) : Task<AuthResponseDto>
    +UnlockSessionAsync(userId : long, dto : UnlockSessionDto) : Task<AuthResponseDto>
    +... 2 autres operations
  }
  interface IClientService <<interface>> {
    +GetAllAsync() : Task<List<ClientDto>>
    +GetByIdAsync(id : long) : Task<ClientDto>
    +CreateAsync(dto : CreateClientDto) : Task<ClientDto>
    +UpdateAsync(id : long, dto : UpdateClientDto) : Task<ClientDto>
    +DeleteAsync(id : long) : Task
  }
  interface IEmailService <<interface>> {
    +SendEmailConfirmationAsync(toEmail : string, token : string) : Task<bool>
    +SendPasswordResetAsync(toEmail : string, token : string) : Task<bool>
    +SendWelcomeAsync(toEmail : string, nom : string) : Task
    +SendMfaOtpAsync(toEmail : string, otp : string) : Task<bool>
  }
  interface IEmployeeService <<interface>> {
    +GetAllAsync() : Task<List<EmployeeDto>>
    +GetByIdAsync(id : long) : Task<EmployeeDto>
    +CreateAsync(dto : CreateEmployeeDto) : Task<EmployeeDto>
    +UpdateAsync(id : long, dto : UpdateEmployeeDto) : Task<EmployeeDto>
    +DeleteAsync(id : long) : Task
    +GetByPostAsync(post : PostEmployee) : Task<List<EmployeeDto>>
    +GetByStatutAsync(statut : StatutEmployee) : Task<List<EmployeeDto>>
  }
  interface IJwtService <<interface>> {
    +GenerateToken(user : Utilisateur) : string
    +GenerateRefreshToken() : string
    +GenerateMfaPendingToken(user : Utilisateur) : string
    +ValidateMfaPendingToken(token : string) : long?
    +GetUserIdFromToken(token : string) : long?
    +ValidateToken(token : string) : bool
  }
  interface IMfaService <<interface>> {
    +GetSettingsAsync(userId : long) : Task<MfaSettingsDto>
    +BeginAuthenticatorSetupAsync(userId : long, email : string, ip : string) : Task<AuthenticatorSetupDto>
    +ConfirmAuthenticatorAsync(userId : long, code : string, ip : string) : Task<MfaSettingsDto>
    +DisableAuthenticatorAsync(userId : long, ip : string) : Task<MfaSettingsDto>
    +ToggleEmailOtpAsync(userId : long, ip : string) : Task<MfaSettingsDto>
    +SendEmailOtpAsync(user : Utilisateur) : Task
    +VerifyEmailOtpAsync(userId : long, code : string) : Task<bool>
    +VerifyAuthenticatorCodeAsync(userId : long, code : string) : Task<bool>
    +GetEnabledMethodsAsync(userId : long) : Task<List<string>>
    +RecordLoginAsync(userId : long, loginMethod : string, mfaMethod : string?, ip : string?, userAgent : string?, success : bool, failureReason : string?) : Task
    +... 4 autres operations
  }
  interface IUserArchiveService <<interface>> {
    +GetDependenciesAsync(userId : long) : Task<UserDependenciesDto>
    +DeleteOrArchiveAsync(adminId : long, userId : long) : Task<DeleteOrArchiveResultDto>
    +GetArchivedAsync() : Task<IEnumerable<ArchivedUserDto>>
    +RestoreAsync(userId : long) : Task
    +PurgeAsync(userId : long) : Task
  }
  interface IUserService <<interface>> {
    +GetProfileAsync(userId : long) : Task<UserProfileDto>
    +UpdateProfileAsync(userId : long, dto : UpdateProfileDto) : Task<UserProfileDto>
    +ChangePasswordAsync(userId : long, dto : ChangePasswordDto) : Task
    +GetAllUsersAsync() : Task<List<UserProfileDto>>
    +ApproveUserAsync(adminId : long, dto : ApproveUserDto) : Task
    +RejectUserAsync(adminId : long, dto : RejectUserDto) : Task
    +ChangeRoleAsync(adminId : long, dto : ChangeRoleDto) : Task
    +SuspendUserAsync(adminId : long, userId : long) : Task
    +DeleteUserAsync(adminId : long, userId : long) : Task
    +ActivateUserAsync(adminId : long, userId : long) : Task
  }
}

