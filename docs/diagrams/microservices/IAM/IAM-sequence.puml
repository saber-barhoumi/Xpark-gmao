@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title IAM - Inscription puis approbation d'un compte

autonumber

actor "Visiteur" as V
participant "frontoffice" as FO
participant "AuthController" as AC
participant "AuthService" as AS
database "postgres" as PG
participant "SMTP" as SM
queue "rabbitmq" as MQ
actor "ADMIN" as AD
participant "backoffice" as BO
participant "UserManagementController" as UM
participant "UserService" as US

V -> FO : formulaire d'inscription
FO -> AC : POST /api/auth/register
activate AC
AC -> AS : RegisterAsync(dto)
AS -> PG : verifie l'unicite de l'email
AS -> AS : hachage BCrypt du mot de passe
AS -> PG : INSERT Utilisateurs (statut EN_ATTENTE)
AS -> MQ : Publish(UserRegisteredEvent)
AS -> SM : courriel de confirmation
AS --> AC : compte cree
AC --> FO : 200 en attente d'approbation
deactivate AC

AD -> BO : ouvre /users/pending
BO -> UM : GET /api/user-management/pending
UM --> BO : comptes en attente
AD -> BO : approuve un compte
BO -> UM : POST approbation
activate UM
UM -> US : ApproveAsync(userId)
US -> PG : UPDATE Statut = ACTIF
US -> MQ : Publish(UserApprovedEvent)
US --> UM : ok
UM --> BO : 200
deactivate UM


legend right
Reconstitue depuis AuthController, UserManagementController,
AuthService et UserService.
endlegend

@enduml
