    +Delete() : DELETE {id:long}
  }
  class CarburantsController {
    <<Route api/[controller]>>
    +GetAll() : GET /
    +GetStats() : GET stats
    +GetById() : GET {id:long}
    +Create() : POST /
    +Delete() : DELETE {id:long}
  }
  class DocumentsController {
    <<Route api/documents>>
    +GetByVehicule() : GET vehicule/{vehiculeId:long}
    +GetById() : GET {id:long}
    +Create() : POST /
    +Delete() : DELETE {id:long}
  }
  class EcheancesController {
    <<Route api/echeances>>
    +GetAll() : GET /
  }
  class EquipementsController {
    <<Route api/equipements>>
    +GetAll() : GET /
