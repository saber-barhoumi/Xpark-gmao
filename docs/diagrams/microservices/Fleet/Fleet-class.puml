    +Update() : PUT {id:long}
    +Delete() : DELETE {id:long}
  }
  class VehiculesController {
    <<Route api/[controller]>>
    +GetAll() : GET /
    +GetById() : GET {id:long}
    +GetByImmatriculation() : GET immatriculation/{immatriculation}
