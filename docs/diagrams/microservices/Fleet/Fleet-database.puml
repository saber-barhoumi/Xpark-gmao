@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Fleet - Persistance

skinparam linetype ortho
hide circle

database "postgres : xpark_gmao" {
  package "Accede par FleetDbContext" #FFF8E1 {
    entity "Assurances" as Assurance {
      IdAssurance : long
      Compagnie : string
      NumeroPolice : string
      DateDebut : DateTime
      DateFin : DateTime
      Prime : double
      TypeAssurance : string
      ContactCompagnie : string?
      Observations : string?
      Actif : bool
      VehiculeId : long
      DateCreation : DateTime
    }
    entity "Carburants" as Carburant {
      IdCarburant : long
      DateRemplissage : DateTime
      Quantite : double
      PrixUnitaire : double
      MontantTotal : double
      Kilometrage : double
      Station : string?
      NumeroBon : string?
      TypeCarburant : string
      VehiculeId : long
      ChauffeurId : long?
      SourceId : long?
      JustificatifUrl : string?
      DateCreation : DateTime
    }
    entity "DocumentsAdministratifs" as DocumentAdministratif {
      IdDocument : long
      NumeroDocument : string
      DateEmission : DateTime
      DateExpiration : DateTime
      Autorite : string?
      FichierPath : string?
      Observations : string?
      VehiculeId : long
      DateCreation : DateTime
    }
    entity "Equipements" as Equipement {
      IdEquipement : long
      Nom : string
      CodeInventaire : string
      Marque : string?
      Modele : string?
      NumeroSerie : string?
      Fournisseur : string?
      ImageUrl : string?
      DateAchat : DateTime?
      PrixAchat : decimal?
      DateFinGarantie : DateTime?
      DureeVieTheoriqueEnMois : int
      NombreUtilisations : int
    }
    entity "Sources" as Source {
      IdSource : long
      NomSource : string
      Adresse : string?
      Ville : string?
      Longitude : double?
      Latitude : double?
      PrixMoyen : double?
      RemiseFiotte : double?
      CodeCarte : string?
      Actif : bool
      DateCreation : DateTime
    }
    entity "Vehicules" as Vehicule {
      IdVehicule : long
      Marque : string
      Modele : string
      NumeroChassis : string
      Immatriculation : string
      AnneeConstruction : int
      Kilometrage : double
      Couleur : string?
      NombrePlaces : int
      ConsommationMoyenne : double
      DateAcquisition : DateTime
      ValeurAcquisition : double
      PuissanceFiscale : int
    }
  }
}

note as N
  DbContext : FleetDbContext
  6 DbSet declares.
  Fournisseur : Npgsql (PostgreSQL 16).
end note

@enduml
