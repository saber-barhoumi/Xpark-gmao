@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

title Fleet - Chaine interne en couches

skinparam componentStyle rectangle

actor "Client du service" as CLIENT

package "Couche Presentation (API)" as P_API {
  component "AssurancesController\n<<control>>" as CTRL
  component "Reponse applicative\n<<value object>>" as RESP
}

package "Couche Application" as P_APP {
  interface "IXparkEventBus" as IXparkEventBus
  interface "IAssuranceService" as IAssuranceService
  interface "ICarburantService" as ICarburantService
  component "Objets de transfert (DTO)" as DTO
}

package "Couche Domaine" as P_DOM {
  component "Assurance\nCarburant\nDocumentAdministratif\nEquipement" as ENT
}

package "Couche Infrastructure" as P_INF {
  component "XparkEventBus\n<<service>>" as XparkEventBus
  component "AssuranceService\n<<service>>" as AssuranceService
  component "CarburantService\n<<service>>" as CarburantService
  component "FleetDbContext\n<<repository>>" as CTX
}

database "Base de donnees" as BD

' Flux de la demande, puis retour par le controleur
CLIENT --> CTRL : demande
CTRL --> CLIENT : reponse
CTRL ..> IXparkEventBus : << use >>
CTRL ..> RESP : << use >>
RESP ..> DTO : << use >>

' Inversion de dependance : l'Infrastructure realise les contrats
' declares par l'Application. Aucune fleche ne part de l'Application
' vers l'Infrastructure.
XparkEventBus ..|> IXparkEventBus
AssuranceService ..|> IAssuranceService
CarburantService ..|> ICarburantService

XparkEventBus ..> ENT : << use >>
AssuranceService ..> ENT : << use >>
CarburantService ..> ENT : << use >>
CTX ..> ENT : << use >>
XparkEventBus ..> CTX : << use >>
CTX --> BD

P_APP ..> P_DOM : << use >>

note bottom of P_APP
  Les dependances pointent toutes vers l'interieur :
  Presentation et Infrastructure dependent de l'Application,
  l'Application depend du Domaine, le Domaine ne depend de rien.
end note

@enduml
