@startuml
skinparam style strictuml
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign first
autonumber

title Fleet - Changement d'etat d'un vehicule

actor "Gestionnaire" as G
participant "VehiculesController" as CTRL <<control>>
participant "IVehiculeService" as IVS <<interface>>
participant "VehiculeService" as VS <<service>>
participant "IXparkEventBus" as IBUS <<interface>>
participant "XparkEventBus" as BUS <<adapter>>
participant "FleetDbContext" as REPO <<repository>>
database "Base de donnees" as BD

G -> CTRL : modifierVehicule(vehiculeDto)
activate CTRL
CTRL -> IVS : modifierAsync(vehiculeDto)
activate IVS
IVS -> VS : modifierAsync(vehiculeDto)
activate VS

VS -> REPO : mettreAJour(vehicule)
activate REPO
REPO -> BD : enregistrer
activate BD
BD --> REPO : confirmation
deactivate BD
REPO --> VS : vehicule
deactivate REPO

alt statut devenu HORS_SERVICE
  VS -> IBUS : publierEvenement("xpark.fleet.vehicle-breakdown", "HIGH", donnees)
  activate IBUS
  IBUS -> BUS : publierEvenement(...)
  activate BUS
  BUS --> IBUS : accuse de publication
  deactivate BUS
  IBUS --> VS : accuse de publication
  deactivate IBUS
else statut devenu BESOIN_MAINTENANCE
  VS -> IBUS : publierEvenement("xpark.fleet.maintenance-due", "MEDIUM", donnees)
  activate IBUS
  IBUS -> BUS : publierEvenement(...)
  activate BUS
  BUS --> IBUS : accuse de publication
  deactivate BUS
  IBUS --> VS : accuse de publication
  deactivate IBUS
else autre statut
  VS -> VS : aucun evenement publie
end

VS --> IVS : vehiculeDto
deactivate VS
IVS --> CTRL : vehiculeDto
deactivate IVS
CTRL --> G : vehiculeDto
deactivate CTRL

@enduml
