@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
hide empty members

class Assurance <<entity>> {
  -idAssurance : Long {id}
  -compagnie : String
  -numeroPolice : String
  -dateDebut : Date
  -dateFin : Date
  -prime : Double
  -typeAssurance : String
  -contactCompagnie : String
  -observations : String
  -actif : Boolean
  -dateCreation : Date
}
class Carburant <<entity>> {
  -idCarburant : Long {id}
  -dateRemplissage : Date
  -quantite : Double
  -prixUnitaire : Double
  -montantTotal : Double
  -kilometrage : Double
  -station : String
  -numeroBon : String
  -typeCarburant : String
  -justificatifUrl : String
  -dateCreation : Date
}
class DocumentAdministratif <<entity>> {
  -idDocument : Long {id}
  -numeroDocument : String
  -dateEmission : Date
  -dateExpiration : Date
  -autorite : String
  -fichierPath : String
  -observations : String
  -dateCreation : Date
}
class Equipement <<entity>> {
  -idEquipement : Long {id}
  -nom : String
  -codeInventaire : String
  -marque : String
  -modele : String
  -numeroSerie : String
  -fournisseur : String
  -imageUrl : String
  -dateAchat : Date
  -prixAchat : Decimal
  -dateFinGarantie : Date
  -dureeVieTheoriqueEnMois : Integer
  -nombreUtilisations : Integer
  -heuresUtilisation : Decimal
  -seuilUsureUtilisations : Integer
  -seuilRemplacementUtilisations : Integer
  -notesGenerales : String
  -actif : Boolean
  -dateCreation : Date
  -dateModification : Date
}
class Source <<entity>> {
  -idSource : Long {id}
  -nomSource : String
  -adresse : String
  -ville : String
  -longitude : Double
  -latitude : Double
  -prixMoyen : Double
  -remiseFiotte : Double
  -codeCarte : String
  -actif : Boolean
  -dateCreation : Date
}
class Vehicule <<entity>> {
  -idVehicule : Long {id}
  -marque : String
  -modele : String
  -numeroChassis : String
  -immatriculation : String
  -anneeConstruction : Integer
  -kilometrage : Double
  -couleur : String
  -nombrePlaces : Integer
  -consommationMoyenne : Double
  -dateAcquisition : Date
  -valeurAcquisition : Double
  -puissanceFiscale : Integer
  -photo : String
  -dateDerniereRevision : Date
  -dateProchaineRevision : Date
  -kilometrageProchainRevision : Double
  -actif : Boolean
  -dateCreation : Date
  -chargeUtileKg : Double
}

Vehicule "1" *-- "0..*" Assurance : couvertures >
Vehicule "1" *-- "0..*" DocumentAdministratif : documents >
Vehicule "1" o-- "0..*" Carburant : pleins >
Source "1" o-- "0..*" Carburant : approvisionnements >
Vehicule "0..1" o-- "0..*" Equipement : dotation >

@enduml
