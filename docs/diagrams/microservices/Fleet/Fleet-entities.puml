@startuml
skinparam style strictuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Fleet - Entites du domaine

hide empty methods
skinparam linetype ortho

entity "Assurance" as Assurance {
  IdAssurance : long <<PK>>
  Compagnie : string
  NumeroPolice : string
  DateDebut : DateTime
  DateFin : DateTime
  Prime : double
  TypeAssurance : string
  ContactCompagnie : string?
  Observations : string?
  Actif : bool
  VehiculeId : long <<FK>>
  DateCreation : DateTime
}
entity "Carburant" as Carburant {
  IdCarburant : long <<PK>>
  DateRemplissage : DateTime
  Quantite : double
  PrixUnitaire : double
  MontantTotal : double
  Kilometrage : double
  Station : string?
  NumeroBon : string?
  TypeCarburant : string
  VehiculeId : long <<FK>>
  ChauffeurId : long? <<FK>>
  SourceId : long? <<FK>>
  JustificatifUrl : string?
  DateCreation : DateTime
}
entity "DocumentAdministratif" as DocumentAdministratif {
  IdDocument : long
  NumeroDocument : string
  DateEmission : DateTime
  DateExpiration : DateTime
  Autorite : string?
  FichierPath : string?
  Observations : string?
  VehiculeId : long <<FK>>
  DateCreation : DateTime
}
entity "Equipement" as Equipement {
  IdEquipement : long <<PK>>
  Nom : string
  CodeInventaire : string
  Marque : string?
  Modele : string?
  NumeroSerie : string?
  Fournisseur : string?
  ImageUrl : string?
  DateAchat : DateTime?
  PrixAchat : decimal?
  DateFinGarantie : DateTime?
  DureeVieTheoriqueEnMois : int
  NombreUtilisations : int
  HeuresUtilisation : decimal
  SeuilUsureUtilisations : int?
  SeuilRemplacementUtilisations : int?
  VehiculeId : long? <<FK>>
  NotesGenerales : string?
  Actif : bool
  DateCreation : DateTime
  DateModification : DateTime
}
entity "Source" as Source {
  IdSource : long <<PK>>
  NomSource : string
  Adresse : string?
  Ville : string?
  Longitude : double?
  Latitude : double?
  PrixMoyen : double?
  RemiseFiotte : double?
  CodeCarte : string?
  Actif : bool
  DateCreation : DateTime
}
entity "Vehicule" as Vehicule {
  IdVehicule : long <<PK>>
  Marque : string
  Modele : string
  NumeroChassis : string
  Immatriculation : string
  AnneeConstruction : int
  Kilometrage : double
  Couleur : string?
  NombrePlaces : int
  ConsommationMoyenne : double
  DateAcquisition : DateTime
  ValeurAcquisition : double
  PuissanceFiscale : int
  Photo : string?
  DateDerniereRevision : DateTime?
  DateProchaineRevision : DateTime?
  KilometrageProchainRevision : double?
  Actif : bool
  DateCreation : DateTime
  ChargeUtileKg : double
}

Assurance "0..*" --> "1" Vehicule : Vehicule
Carburant "0..*" --> "1" Vehicule : Vehicule
Carburant "0..*" --> "1" Source : Source
DocumentAdministratif "0..*" --> "1" Vehicule : Vehicule
Equipement "0..*" --> "1" Vehicule : Vehicule
Source "1" *-- "0..*" Carburant : ConsommationsCarburant
Vehicule "1" *-- "0..*" Assurance : Assurances
Vehicule "1" *-- "0..*" DocumentAdministratif : Documents
Vehicule "1" *-- "0..*" Carburant : Carburants
Vehicule "1" *-- "0..*" Equipement : Equipements

@enduml
