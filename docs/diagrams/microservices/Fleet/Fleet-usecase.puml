@startuml
skinparam style strictuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
skinparam nodesep 18
skinparam ranksep 80
left to right direction

' Acteurs, alignes a gauche : les porteurs d'associations sont
' accoles a la frontiere, les acteurs structurels a leur gauche
actor "Utilisateur" as Utilisateur
actor "Employe" as Employe
actor "Responsable" as Responsable
actor "Administrateur" as Administrateur
actor "Gestionnaire" as Gestionnaire

' Generalisation : triangle creux, de l'enfant vers le parent
Employe -down-|> Utilisateur
Responsable -up-|> Employe
Administrateur -left-|> Responsable
Gestionnaire -down-|> Responsable

rectangle "Service Flotte" {
  package "Exploitation courante" {
    usecase "Consulter le parc" as UC_Consulter_le_parc
    usecase "Consulter les pieces administratives" as UC_Consulter_les_pieces_administrativ
    usecase "Suivre la consommation de carburant" as UC_Suivre_la_consommation_de_carburan
    usecase "Declarer un plein de carburant" as UC_Declarer_un_plein_de_carburant
    usecase "Affecter et restituer un equipement" as UC_Affecter_et_restituer_un_equipemen
    usecase "Realiser une inspection" as UC_Realiser_une_inspection
    usecase "Gerer les contrats de garantie" as UC_Gerer_les_contrats_de_garantie
  }
  package "Tenue du referentiel" {
    usecase "Tenir la fiche d'un vehicule" as UC_Tenir_la_fiche_d_un_vehicule
    usecase "Tenir la fiche d'un equipement" as UC_Tenir_la_fiche_d_un_equipement
    usecase "Enregistrer une piece administrative" as UC_Enregistrer_une_piece_administrati
  }
  package "Retrait definitif" {
    usecase "Sortir un bien de l'inventaire" as UC_Sortir_un_bien_de_l_inventaire
  }
  usecase "Verifier les equipements avant mission" as UC_Verifier_les_equipements_avant_mis
}

' Associations : trait continu sans fleche (relation d'association)
Utilisateur -- UC_Consulter_le_parc
Utilisateur -- UC_Consulter_les_pieces_administrativ
Utilisateur -- UC_Suivre_la_consommation_de_carburan
Utilisateur -- UC_Declarer_un_plein_de_carburant
Utilisateur -- UC_Affecter_et_restituer_un_equipemen
Utilisateur -- UC_Realiser_une_inspection
Utilisateur -- UC_Gerer_les_contrats_de_garantie
Responsable -- UC_Tenir_la_fiche_d_un_vehicule
Responsable -- UC_Tenir_la_fiche_d_un_equipement
Responsable -- UC_Enregistrer_une_piece_administrati
Administrateur -- UC_Sortir_un_bien_de_l_inventaire

' << extend >> : la pointe designe le cas de base
UC_Affecter_et_restituer_un_equipemen <.. UC_Verifier_les_equipements_avant_mis : << extend >>

@enduml
