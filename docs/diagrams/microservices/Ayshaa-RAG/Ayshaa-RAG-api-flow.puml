@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Ayshaa-RAG - Cheminement d'un appel API

autonumber

actor Client as U
participant "backoffice" as BO #E1F5FE
participant "nginx back-office" as N1
participant "nginx passerelle" as N2
participant "ayshaa-rag\nFastAPI" as A #FCE4EC

U -> BO : action
BO -> A : POST /chat { message, langue }
activate A
A -> A : detection de langue + routage
A -> A : recherche hybride (vecteurs + BM25)
A -> A : generation ou repli extractif
A --> BO : reponse + sources
deactivate A

legend right
8 endpoints FastAPI exposes par ce service.
endlegend

@enduml
