@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title Ayshaa-RAG - Communications

skinparam componentStyle rectangle

component "**ayshaa-rag**" as ME #E8F5E9

component "backoffice" as BO #E1F5FE
component "nginx" as GWc #ECEFF1
database "postgres" as PG #FFF8E1
queue "rabbitmq" as MQ #ECEFF1

component "frontoffice" as FO #E1F5FE
FO -[#0066CC]-> ME : POST /chat
component "iam-api" as iam_api #E8F5E9
ME -[#0066CC]-> iam_api : outils metier
component "fleet-api" as fleet_api #E8F5E9
ME -[#0066CC]-> fleet_api : outils metier
component "mission-api" as mission_api #E8F5E9
ME -[#0066CC]-> mission_api : outils metier
component "ai-predictor" as ai_predictor #E8F5E9
ME -[#0066CC]-> ai_predictor : outils metier
database "qdrant" as QD #FFF8E1
component "ollama" as OL #FCE4EC
ME -[#666666]-> QD : recherche vectorielle
ME -[#0066CC]-> OL : generation (repli extractif si absent)

legend right
Bleu : HTTP · Orange : AMQP · Vert : WebSocket · Gris : base de donnees.
endlegend

@enduml
