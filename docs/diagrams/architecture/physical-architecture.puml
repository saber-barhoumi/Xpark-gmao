@startuml
skinparam style strictuml
skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
skinparam roundcorner 6
skinparam nodesep 30
skinparam ranksep 45
skinparam padding 3
skinparam linetype ortho
skinparam ArrowColor #546E7A
skinparam ArrowFontSize 10
skinparam ArrowFontColor #37474F
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #C5B358

' =====================================================================
'  Vue de deploiement : bandes empilees, le flux descend.
'
'  Un conteneur n'est PAS un noeud : chaque groupe de conteneurs en est
'  un, et les conteneurs qu'il contient sont enumeres a l'interieur avec
'  leur publication de ports. Relier les vingt conteneurs un par un a la
'  base, au courtier et aux volumes donnait une quarantaine de traits
'  croises. Le detail conteneur par conteneur figure dans
'  docs/diagrams/infrastructure/ et docs/diagrams/platform/.
' =====================================================================

' ---------------------------------------------------------------- 1
node "Zone publique" as ZPUB #E3F2FD {
  artifact "Navigateur web" as NAV
  artifact "Application chauffeur\nAndroid / iOS" as MOB
}

cloud "Internet" as NET

' ---------------------------------------------------------------- 2
node "Hote Docker  <<serveur d'execution unique - docker compose>>" as HOTE #FAFAFA {

  node "Conteneurs exposes  <<publication de ports>>" as ZEXPO #ECEFF1 {
    artifact "xpark-backoffice\nnginx 1.27 + fichiers React\n**8080 -> 80/tcp**" as CBO
    artifact "xpark-frontoffice\nNode 20 + Next.js\n**3001 -> 3000/tcp**" as CFO
    artifact "xpark-nginx  <<passerelle>>\nnginx 1.25-alpine\n**8080 -> 80/tcp**" as CGW
  }

  node "Reseau bridge xpark-network  <<resolution DNS par nom de service>>" as ZNET #FFFFFF {

    artifact "Conteneurs applicatifs .NET 8\n<<ASP.NET Core - 8 conteneurs>>\n--\nxpark-iam-api  5001         xpark-alerts-api  5006\nxpark-fleet-api  5002       xpark-chat-api  5007\nxpark-mission-api  5003     xpark-prediction-api  5009\nxpark-maintenance-api  5004\nxpark-finance-api  5005\n--\ntous ecoutent sur le port 80 dans le reseau" as ZAPP #E8F5E9

    artifact "Conteneurs applicatifs Python\n<<FastAPI / uvicorn - 4 conteneurs>>\n--\nxpark-ai-predictor  8000 -> 8000/tcp\nxpark-ai-optimizer  8001 -> 8000/tcp\nxpark-iboa  5008 -> 8000/tcp\nxpark-ayshaa-rag  8010 -> 8010/tcp" as ZIA #FCE4EC

    artifact "xpark-postgres\npostgres:16-alpine\n**5432/tcp**" as CPG #FFF8E1
    artifact "xpark-rabbitmq\nrabbitmq:3.13-management\n**5672/tcp** + **15672/tcp**" as CMQ #FFF3E0
    artifact "xpark-qdrant\nqdrant:v1.12.4\n**6333/tcp**" as CQD #FFF8E1
    artifact "xpark-ollama\nollama:latest\n**11434/tcp**" as COL #FCE4EC
  }

  storage "Volumes persistants\n--\npostgres-data, rabbitmq-data, qdrant-data,\nollama-data, ./data/uploads (montage hote)" as VOL #EEEEEE
}

' ---------------------------------------------------------------- 3
node "Systemes tiers" as TIERS #ECEFF1 {
  artifact "Serveur SMTP\n587/tcp + STARTTLS" as SMTP
  artifact "API Twilio\nHTTPS 443/tcp" as TW
  artifact "API xAI Grok\nHTTPS 443/tcp" as GROK
}

' =====================================================================
'  Liaisons : une par couple de groupes, protocole et port annotes
' =====================================================================
NAV -down-> NET : HTTP
MOB -down-> NET : HTTP

NET -down-> ZEXPO : HTTP 8080 et 3001/tcp
NET -down-> ZAPP : HTTP 5001 et 5003/tcp\nconnexion et suivi GPS, en direct

CBO -down-> CGW : HTTP 80/tcp\nproxy_pass, resolution dynamique
CGW -down-> ZAPP : HTTP 80/tcp
CFO -down-> ZIA : HTTP 8000/tcp
CBO -down-> ZAPP : WebSocket 80/tcp\nSignalR, en-tete Upgrade conserve

ZAPP -down-> CPG : TCP 5432\nNpgsql
ZIA -down-> CPG : TCP 5432\npsycopg2
ZAPP <-down-> CMQ : AMQP 5672
ZIA <-down-> CMQ : AMQP 5672
ZIA -down-> CQD : HTTP 6333/tcp
ZIA -down-> COL : HTTP 11434/tcp

CPG -down-> VOL
CMQ -down-> VOL
CQD -down-> VOL
COL -down-> VOL
ZAPP -down-> VOL

ZAPP -right-> SMTP : SMTP 587/tcp
ZIA -right-> TIERS : SMTP 587 et HTTPS 443/tcp
NAV -right-> GROK : HTTPS 443/tcp\nOCR execute dans le navigateur

' =====================================================================
'  Ecarts assumes par rapport a la cible
' =====================================================================
note right of ZEXPO
  **Pas de terminaison TLS.** La passerelle publie
  8080 -> 80 en clair ; aucun certificat ni directive
  listen ... ssl dans les deux fichiers nginx.conf.
  Le port 443 devra etre ajoute avant toute mise en
  ligne, avec redirection depuis le port 80.
end note

note right of ZNET
  Une seule instance PostgreSQL heberge xpark_gmao,
  partagee par les huit services .NET : il n'y a pas
  une instance par microservice. Aucun conteneur de
  cache : Redis n'est declare nulle part.
  Les ports 5001 a 5009 ne sont que des publications
  vers l'hote, utiles au diagnostic et aux appels
  directs du portail client ; a l'interieur du reseau
  les services s'appellent par leur nom sur le port 80.
  Aucun echange gRPC : tout le synchrone est en REST.
end note

note bottom of HOTE
  Orchestration par docker compose, sur un hote unique : ni manifeste
  Kubernetes, ni chart Helm dans le depot. L'ordre de demarrage repose
  sur depends_on avec la condition service_healthy - postgres et
  rabbitmq d'abord, puis les services metier, puis la passerelle.
  Les huit services .NET exposent /health ; les quatre services Python
  et la passerelle n'ont pas encore de sonde.
end note

@enduml
