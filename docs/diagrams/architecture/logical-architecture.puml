@startuml
skinparam style strictuml
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam backgroundColor #FFFFFF
skinparam roundcorner 6
skinparam nodesep 25
skinparam ranksep 45
skinparam padding 3
skinparam linetype ortho
skinparam ArrowColor #546E7A
skinparam ArrowFontSize 10
skinparam ArrowFontColor #37474F
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #C5B358

' =====================================================================
'  Vue d'ensemble : quatre niveaux empiles, le flux descend.
'
'  Un microservice n'est PAS une boite : chaque groupe technologique en
'  est une, et les services qu'il contient sont enumeres a l'interieur.
'  Motif : les huit services .NET partagent la meme passerelle, le meme
'  bus et la meme base. Les relier un par un donnait une trentaine de
'  traits croises qui n'apprenaient rien de plus que le lien de groupe.
'  Le detail service par service figure dans docs/diagrams/platform/ et
'  dans docs/diagrams/microservices/.
' =====================================================================

' ---------------------------------------------------------------- 1
package "Niveau 1 - Presentation" as N1 #E3F2FD {
  component "Back-office\n<<application web>>\nReact 18 + Vite" as BO
  component "Portail client\n<<application web>>\nNext.js 14" as FO
  component "XPARK Driver\n<<application mobile>>\nExpo React Native" as DRV
}

' ---------------------------------------------------------------- 2
package "Niveau 2 - Passerelle" as N2 #ECEFF1 {
  component "nginx\n<<reverse proxy>>\n--\nroutage par prefixe d'URL\nvalidation du jeton JWT HMAC-SHA256\nfiltrage des origines (CORS)" as GW
}

' ---------------------------------------------------------------- 3
package "Niveau 3 - Coeur applicatif et domaine" as N3 #E8F5E9 {
  component "Services metier\n<<8 microservices .NET 8>>\nClean Architecture : API / Application / Domain / Infrastructure\n--\nIAM (identites, MFA, roles)\nFleet (vehicules, equipements)\nMission (devis, missions, suivi)\nMaintenance (interventions, pieces)\nFinance (facturation)\nAlerts (controles metier)\nChat (messagerie temps reel)\nPredictionPanne (maintenance predictive)" as METIER #F1F8E9

  component "Services d'aide a la decision\n<<4 services Python - FastAPI>>\n--\nAI Predictor (estimation tarifaire)\nAI Optimizer (affectation de flotte)\nAyshaa RAG (assistant documentaire)\nIBOA (journal metier)" as IA #FCE4EC

  queue "RabbitMQ\n<<courtier de messages>>\n--\nMassTransit : messages types entre services .NET\nExchange topic xpark.ai : JSON brut lu par Python" as MQ #FFF3E0

  component "XparkGMAO.Shared\n<<bibliotheque partagee>>\nenumerations, evenements d'integration" as SHARED #F5F5F5
}

' ---------------------------------------------------------------- 4
package "Niveau 4 - Persistance" as N4 #FFF8E1 {
  database "xpark_gmao\n<<PostgreSQL 16 - instance unique>>\n--\nhuit schemas logiques :\nIAM, Fleet, Mission, Maintenance,\nFinance, Alerts, Chat, Prediction" as PG
  database "Qdrant\n<<base vectorielle>>" as QD
  storage "Volume partage\n<<fichiers televerses>>" as UP
}

' =====================================================================
'  Un connecteur par couple de groupes
' =====================================================================
BO -down-> GW : HTTP /api/*
FO -down-> GW : HTTP /api/*
DRV -down-> GW : HTTP /api/*

GW -down-> METIER : HTTP, routage par prefixe

' Echanges asynchrones resumes a une liaison par groupe. Le detail des
' 22 evenements figure dans platform/platform-rabbitmq-events.puml.
' Le courtier est place SOUS les deux groupes de calcul : place entre
' eux, les libelles des fleches se superposaient a la boite du courtier.
METIER -[hidden]right- IA
METIER <-down-> MQ : publie / consomme
IA <-down-> MQ : consomme / publie le resultat

METIER .down.> SHARED : << use >>
IA .down.> SHARED : << use >>

METIER -down-> PG : Npgsql
METIER -down-> UP : fichiers televerses
IA -down-> PG : psycopg2 (IBOA)
IA -down-> QD : recherche vectorielle (Ayshaa RAG)

' =====================================================================
'  Ecarts assumes par rapport au patron de reference
' =====================================================================
note left of N2
  Le portail client et l'application chauffeur
  atteignent aussi Mission (suivi GPS) et
  AI Predictor (estimation tarifaire) en direct,
  sans passer par la passerelle : celle-ci ne
  proxifie pas /api/tracking.
  Aucun cache applicatif n'est deploye : Redis
  n'existe nulle part dans le depot.
end note

note right of N4
  **Base partagee, et non une base par service.**
  Les neuf chaines de connexion de docker-compose.yml
  pointent toutes vers xpark_gmao. Le cloisonnement est
  LOGIQUE : chaque service ne possede en ecriture que
  ses propres tables et lit celles des autres domaines
  en SQL direct. D'ou la redeclaration en lecture seule
  de Vehicule, Utilisateur ou Mission dans plusieurs
  couches Domain. Le decouplage repose sur une discipline
  de developpement, pas sur l'infrastructure.
end note

@enduml
