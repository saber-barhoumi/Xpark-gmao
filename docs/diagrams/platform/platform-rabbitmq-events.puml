@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

skinparam componentStyle rectangle

package "Bus 1 - MassTransit (evenements types)" #E3F2FD {
  component "iam-api" as IAMp
  queue "exchanges MassTransit\n(un par type de message)" as MTX
  component "chat-api\nUserStatusChangedConsumer" as CHc
}

IAMp --> MTX : ClientCreatedEvent
IAMp --> MTX : EmployeeCreatedEvent
IAMp --> MTX : UserApprovedEvent
IAMp --> MTX : UserRegisteredEvent
IAMp --> MTX : UserStatusChangedEvent
MTX --> CHc : UserStatusChangedEvent

package "Bus 2 - exchange topic xpark.ai (JSON brut)" #FCE4EC {
  component "fleet-api\nXparkEventBus" as FLp
  component "mission-api\nOptimizerEventBus" as MSp
  queue "exchange topic\nxpark.ai (durable)" as TX
  component "iboa\nfile iboa.events" as IB
  component "ai-optimizer\nfile optimizer.ready-for-optimization" as OP
}

FLp --> TX : xpark.fleet.maintenance-due
FLp --> TX : xpark.fleet.vehicle-added
FLp --> TX : xpark.fleet.vehicle-breakdown
MSp --> TX : xpark.mission.client-request
MSp --> TX : xpark.mission.task-cancelled
MSp --> TX : xpark.mission.task-completed
MSp --> TX : xpark.missions.ready-for-optimization
TX --> IB : liaison xpark.#
TX --> OP : xpark.missions.ready-for-optimization
OP --> TX : xpark.optimization.plan-generated
TX --> MSp : xpark.optimization.plan-generated

legend right
Deux bus coexistent :
- MassTransit, enveloppe typee, utilise par IAM (5 publications)
  et Chat (1 consommateur).
- exchange topic xpark.ai, JSON brut sans enveloppe, pour que les
  services Python consomment directement.

IMPORTANT : 17 des 22 evenements declares dans
XparkGMAO.Shared/Events/IntegrationEvents.cs n'ont AUCUN publieur
ni consommateur dans le code :
  AlerteCreatedEvent, AssuranceExpiringEvent, DocumentExpiringEvent
  EmployeeStatusChangedEvent, FactureCreatedEvent, FacturePayeeEvent
  FactureRetardEvent, InterventionCompletedEvent, InterventionCreatedEvent
  MissionCompletedEvent, MissionCreatedEvent, MissionStatusChangedEvent
  NotificationEmailEvent, OTStatusChangedEvent, StockFaibleEvent
  VehiculeCreatedEvent, VehiculeStatusChangedEvent
endlegend

@enduml
