@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

title XPARK GMAO - Diagramme de composants

component "Back-office React" as BO #E1F5FE
component "Portail client Next.js" as FO #E1F5FE
component "nginx (passerelle)" as GWc #ECEFF1

package "IAM.API" as PIAM #E8F5E9 {
  component "AuthController\napi/auth" as CIAMAuthController
  component "ClientsController\napi/clients" as CIAMClientsController
  component "EmployeesController\napi/employees" as CIAMEmployeesController
  component "UserManagementController\napi/user-management" as CIAMUserManagementController
  component "UsersController\napi/users" as CIAMUsersController
}
package "Fleet.API" as PFleet #E8F5E9 {
  component "AssurancesController\napi/assurances" as CFleetAssurancesController
  component "CarburantsController\napi/[controller]" as CFleetCarburantsController
  component "DocumentsController\napi/documents" as CFleetDocumentsController
  component "EcheancesController\napi/echeances" as CFleetEcheancesController
  component "EquipementsController\napi/equipements" as CFleetEquipementsController
  component "SourcesController\napi/[controller]" as CFleetSourcesController
  component "VehiculesController\napi/[controller]" as CFleetVehiculesController
}
package "Mission.API" as PMission #E8F5E9 {
  component "DataMigrationController\napi/ai-data" as CMissionDataMigrationController
  component "MissionsController\napi/[controller]" as CMissionMissionsController
  component "SupportController\napi/support" as CMissionSupportController
  component "TrackingController\napi/tracking" as CMissionTrackingController
  component "TransportRequestsController\napi/missions/demandes" as CMissionTransportRequestsController
}
package "Maintenance.API" as PMaintenance #E8F5E9 {
  component "InterventionsController\napi/[controller]" as CMaintenanceInterventionsController
  component "OrdreTravailController\napi/ordres-travail" as CMaintenanceOrdreTravailController
  component "PiecesRechangeController\napi/pieces-rechange" as CMaintenancePiecesRechangeController
}
package "Finance.API" as PFinance #E8F5E9 {
  component "CarburantsController\n(sans route)" as CFinanceCarburantsController
  component "FacturesController\napi/[controller]" as CFinanceFacturesController
  component "SourcesController\n(sans route)" as CFinanceSourcesController
}
package "Alerts.API" as PAlerts #E8F5E9 {
  component "AlertesController\napi/[controller]" as CAlertsAlertesController
}
package "Chat.API" as PChat #E8F5E9 {
  component "ChatController\napi/chat" as CChatChatController
}
package "PredictionPanne.API" as PPredictionPanne #E8F5E9 {
  component "PredictionsController\napi/predictions" as CPredictionPannePredictionsController
}

database "PostgreSQL\nxpark_gmao" as PG #FFF8E1
queue "RabbitMQ" as MQ #ECEFF1

BO --> GWc
GWc --> PIAM
PIAM --> PG
GWc --> PFleet
PFleet --> PG
GWc --> PMission
PMission --> PG
GWc --> PMaintenance
PMaintenance --> PG
GWc --> PFinance
PFinance --> PG
GWc --> PAlerts
PAlerts --> PG
GWc --> PChat
PChat --> PG
GWc --> PPredictionPanne
PPredictionPanne --> PG
FO --> PIAM
FO --> PMission
PIAM --> MQ
PChat --> MQ
PFleet --> MQ
PMission --> MQ

legend right
Un composant par controleur reellement present dans le code.
endlegend

@enduml
