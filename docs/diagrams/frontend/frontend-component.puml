@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Verdana
skinparam defaultFontSize 11
skinparam roundCorner 6
skinparam ArrowColor #4A5568
skinparam TitleFontSize 16
skinparam TitleFontColor #1A202C
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #D6BF7A
skinparam componentStyle rectangle

skinparam componentStyle rectangle

package "Point d'entree" #E1F5FE {
  component "main.tsx\nBrowserRouter(basePath)" as Main
  component "App.tsx" as App
  component "AppProvidersWrapper" as Prov
}
package "Contextes" #FFF3E0 {
  component "useChatContext" as useChatContext
  component "useKanbanContext" as useKanbanContext
  component "useLayoutContext" as useLayoutContext
}
package "Mise en page" #ECEFF1 {
  component "VerticalLayout" as VL
  component "TopBar" as TB
  component "LeftSideBar (MENU_ITEMS)" as SB
  component "Footer" as FT
}
package "Acces reseau" #E8F5E9 {
  component "lib/axiosConfig.ts\nintercepteurs jeton + erreurs" as AX
  component "services/ (33 modules)" as SVCf
  component "signalRService.ts" as SR
}
package "Protection des routes" #FFEBEE {
  component "ProtectedRoute" as PR
  component "ErrorBoundary" as EB
}

Main --> App
App --> Prov
Prov --> useChatContext
Prov --> useKanbanContext
Prov --> useLayoutContext
App --> PR
PR --> VL
VL --> TB
VL --> SB
VL --> FT
App --> EB
SVCf --> AX
useChatContext --> SR

legend right
33 services, 3 contextes, 8 hooks reutilisables.
axiosConfig centralise l'injection du jeton (localStorage xpark_token)
et la redirection des codes d'erreur vers les pages dediees.
endlegend

@enduml
