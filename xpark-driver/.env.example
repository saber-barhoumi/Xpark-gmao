# ── XPARK Driver — configuration (copier vers .env) ─────────────────────────
# IMPORTANT : sur un vrai téléphone, "localhost" désigne le téléphone, PAS le PC.
# Mettre l'IP LAN de la machine qui héberge XPARK (ex. 192.168.1.20) ou un tunnel.
# Sur l'émulateur Android, utiliser 10.0.2.2 pour joindre le localhost du PC.

# IAM.API — authentification
EXPO_PUBLIC_IAM_API_URL=http://192.168.1.20:5001/api

# Mission.API — missions du chauffeur + envoi des positions GPS
EXPO_PUBLIC_MISSION_API_URL=http://192.168.1.20:5003/api

# Cadence d'envoi de la position en mission (secondes) et distance mini (mètres)
EXPO_PUBLIC_PING_INTERVAL_SEC=5
EXPO_PUBLIC_PING_DISTANCE_M=25
