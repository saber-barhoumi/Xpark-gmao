# ── Exemple de configuration d'environnement ─────────────────────────────────
# Copier ce fichier vers .env puis remplir avec vos vrais identifiants.
#   cp .env.example .env
# Le vrai .env est ignoré par git (jamais committé).
#
# SMTP pour l'envoi d'emails (confirmation de compte, réinitialisation de mot
# de passe, code OTP MFA). Avec Gmail il faut un "App Password" :
#   https://myaccount.google.com/apppasswords  (validation en 2 étapes requise)
# Sans .env configuré, les emails ne partent pas mais le code est écrit dans les
# logs du conteneur (mode DEV) : docker logs xpark-iam-api | grep "Code OTP\|Token"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=votre_email@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=XPARK GMAO <votre_email@gmail.com>
