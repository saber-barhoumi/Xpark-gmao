# ── Exemple de configuration d'environnement ─────────────────────────────────
# Copier ce fichier vers .env puis remplir avec vos vrais identifiants.
#   cp .env.example .env
# Le vrai .env est ignoré par git (jamais committé).
#
# Toutes les variables ci-dessous ont une valeur par défaut dans
# docker-compose.yml : sans .env, la pile démarre telle quelle en local.
# EN PRODUCTION, elles doivent IMPÉRATIVEMENT être redéfinies.


# ── SECRETS — à changer obligatoirement avant toute mise en ligne ────────────
#
# Clé de signature des jetons d'authentification. Quiconque la connaît peut
# forger un jeton valide et se faire passer pour n'importe quel utilisateur,
# administrateur compris. 32 caractères minimum, aléatoire.
#   Générer :  openssl rand -base64 48
JWT_KEY=CHANGEZ_MOI_cle_aleatoire_de_32_caracteres_minimum

# Mot de passe du compte PostgreSQL applicatif.
POSTGRES_PASSWORD=CHANGEZ_MOI_mot_de_passe_base

# Mot de passe du bus de messages inter-services.
RABBITMQ_PASSWORD=CHANGEZ_MOI_mot_de_passe_bus


# ── Origines autorisées (CORS) ───────────────────────────────────────────────
# Domaines depuis lesquels un navigateur peut appeler l'API, séparés par des
# virgules et SANS barre oblique finale.
# Laissé vide (le défaut), les services acceptent toutes les origines : pratique
# en développement, à ne pas conserver en production.
#   Exemple : CORS_ORIGINS=https://admin.xpark.tn,https://portail.xpark.tn
CORS_ORIGINS=


# ── SMTP (confirmation de compte, réinitialisation, code OTP) ────────────────
# Avec Gmail il faut un « App Password » :
#   https://myaccount.google.com/apppasswords  (validation en 2 étapes requise)
# Sans SMTP configuré, les emails ne partent pas mais le code est écrit dans
# les logs du conteneur (mode DEV) :
#   docker logs xpark-iam-api | grep "Code OTP\|Token"

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=votre_email@gmail.com
EMAIL_PASSWORD=xxxxxxxxxxxxxxxx
EMAIL_FROM=XPARK GMAO <votre_email@gmail.com>


# ── Assistant Ayshaa (site vitrine) ─────────────────────────────────────────
# Clé d'administration de l'API Ayshaa (réindexation de la base documentaire).
AYSHAA_ADMIN_API_KEY=CHANGEZ_MOI_cle_admin_ayshaa
