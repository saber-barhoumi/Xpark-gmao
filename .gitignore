# ── Secrets / variables d'environnement ──────────────────────────────────────
# Ne JAMAIS committer les vrais identifiants (SMTP, clés API…).
# Copier .env.example → .env et remplir localement.
.env
.env.local
.env.*.local
*.env
!.env.example
data/uploads/*
!data/uploads/.gitkeep
!data/uploads/avatars
data/uploads/avatars/*
!data/uploads/avatars/.gitkeep
!data/uploads/chat
data/uploads/chat/*
!data/uploads/chat/.gitkeep

# Artefacts de build .NET (introduits proprement avec la migration Clean Architecture)
microservices/**/bin/
microservices/**/obj/

# Installeurs et archives deposes dans les dossiers de ressources du
# rapport : ils depassent la limite de 100 Mo de GitHub et n'ont pas
# vocation a etre versionnes.
*.exe
*.msi
*.iso
